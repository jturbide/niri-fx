  "catalog_documents": {
    "balanced": { "schema": 3, "effect": { "family": "fragments", "resize": false } },
    "spring-wobble": { "schema": 3, "effect": { "family": "elastic", "resize": false } },
    "frost-vanish": { "schema": 3, "effect": { "family": "dissolve", "resize": false } },
    "soft-landing": {
      "kind": "profile",
      "schema": 2,
      "actions": {
        "open": { "family": "elastic" },
        "close": { "family": "dissolve" },
        "resize": null,
        "movement": null
      }
    }
  },
  "cli_json": [
    {
      "id": "discovery",
      "argv": ["agent-info"],
      "expected": {
        "schema": 1,
        "name": "NiriFX",
        "transport": "cli",
        "document_formats": {
          "effect_schema": 3,
          "profile_schema": 2,
          "action_modes": { "preserve": null, "off": "off", "style": "effect object" },
          "max_bytes": 16384
        },
        "operations": {
          "catalog": { "output": "json", "effect": "read-only" },
          "validate": { "argv": ["inspect", "--custom", "./my-combo.json"] }
        },
        "experimental_actions": {
          "movement": { "consent_flag": "--enable-movement" },
          "pointer": { "consent_flag": "--enable-pointer" }
        }
      }
    },
    {
      "id": "parameter-units-and-limits",
      "argv": ["agent-info", "--parameters"],
      "expected": {
        "schema": 1,
        "effects": {
          "open_ms": {
            "type": "number",
            "default": 520,
            "limits": [100, 1500],
            "integer": true,
            "unit": " ms"
          },
          "fragment_aspect": { "default": 1, "limits": [0.25, 4] }
        },
        "pointer": { "limits": { "strength": [0, 2] } }
      }
    },
    {
      "id": "compose-action-choices-and-alias",
      "argv": [
        "profile",
        "--name",
        "CLI choices",
        "--open",
        "preserve",
        "--close-preset",
        "frost-vanish",
        "--resize",
        "off",
        "--movement",
        "off",
        "--pointer",
        "off"
      ],
      "expected": {
        "kind": "profile",
        "schema": 2,
        "name": "CLI choices",
        "actions": {
          "open": null,
          "close": { "family": "dissolve" },
          "resize": "off",
          "movement": "off"
        },
        "pointer": { "strength": 0 }
      }
    },
    {
      "id": "inspect-built-in-profile",
      "argv": ["inspect", "--profile", "soft-landing"],
      "expected": {
        "kind": "profile",
        "schema": 2,
        "actions": {
          "open": { "family": "elastic" },
          "close": { "family": "dissolve" },
          "resize": null,
          "movement": null
        }
      }
    },
    {
      "id": "compact-catalog",
      "argv": ["list", "--summary", "--search", "spring-wobble"],
      "expected": {
        "spring-wobble": { "kind": "effect", "families": ["elastic"], "optional_actions": [] }
      }
    }
  ],
  "cli_errors": [
