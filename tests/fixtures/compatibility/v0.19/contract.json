{
  "baseline": "0.19",
  "status": "Starting compatibility corpus; not a 1.0 contract freeze",
  "accepted_documents": [
    {
      "id": "style-defaults",
      "meaning": "Omitted style parameters use documented defaults; resize remains unchanged by default.",
      "document": { "schema": 3, "name": "Default style", "effect": {} },
      "normalized": {
        "schema": 3,
        "effect": { "family": "fragments", "open_ms": 520, "close_ms": 480, "resize": false }
      },
      "absent": ["kind", "actions", "pointer"],
      "stock_actions": {
        "window-open": { "duration_ms": 520, "shader": true },
        "window-close": { "duration_ms": 480, "shader": true }
      }
    },
    {
      "id": "style-boundaries",
      "meaning": "Supported boundary values retain their units and values after import.",
      "document": {
        "schema": 3,
        "name": "Boundary style",
        "effect": {
          "fragment_aspect": 0.25,
          "fragment_roundness": 1,
          "open_ms": 100,
          "close_ms": 1500
        }
      },
      "normalized": {
        "schema": 3,
        "effect": {
          "fragment_aspect": 0.25,
          "fragment_roundness": 1,
          "open_ms": 100,
          "close_ms": 1500
        }
      },
      "absent": ["actions"],
      "stock_actions": {
        "window-open": { "duration_ms": 100, "shader": true },
        "window-close": { "duration_ms": 1500, "shader": true }
      }
    },
    {
      "id": "legacy-profile",
      "meaning": "Schema 1 imports normalize to schema 2 without changing selected styles or optional-action inheritance; null pointer normalizes to omission.",
      "document": {
        "kind": "profile",
        "schema": 1,
        "name": "Legacy pair",
        "actions": {
          "open": { "family": "elastic", "open_ms": 420 },
          "close": { "family": "dissolve", "close_ms": 610 },
          "resize": null,
          "movement": null
        },
        "pointer": null
      },
      "normalized": {
        "kind": "profile",
        "schema": 2,
        "actions": {
          "open": { "family": "elastic", "open_ms": 420, "resize": false },
          "close": { "family": "dissolve", "close_ms": 610, "resize": false },
          "resize": null,
          "movement": null
        }
      },
      "absent": ["pointer", "motion"],
      "stock_actions": {
        "window-open": { "duration_ms": 420, "shader": true },
        "window-close": { "duration_ms": 610, "shader": true }
      }
    },
    {
      "id": "preserve-all",
      "meaning": "Explicit null actions preserve the underlying configuration by emitting no action overrides.",
      "document": {
        "kind": "profile",
        "schema": 2,
        "name": "Preserve all",
        "actions": { "open": null, "close": null, "resize": null, "movement": null }
      },
      "normalized": {
        "kind": "profile",
        "schema": 2,
        "actions": { "open": null, "close": null, "resize": null, "movement": null }
      },
      "absent": ["pointer", "motion"],
      "stock_actions": {}
    },
    {
      "id": "resize-style-movement-off",
      "meaning": "Preserve, Off and Style are independent; movement Off and pointer Off remain portable data without stock activation.",
      "document": {
        "kind": "profile",
        "schema": 2,
        "name": "Resize choice",
        "actions": {
          "open": null,
          "close": "off",
          "resize": { "family": "elastic", "resize_ms": 360 },
          "movement": "off"
        },
        "pointer": { "strength": 0, "damping": 65, "frequency": 8 }
      },
      "normalized": {
        "schema": 2,
        "actions": {
          "open": null,
          "close": "off",
          "resize": { "family": "elastic", "resize_ms": 360, "resize": false },
          "movement": "off"
        },
        "pointer": { "strength": 0, "damping": 65, "frequency": 8 }
      },
      "absent": ["motion"],
      "stock_actions": {
        "window-close": { "off": true },
        "window-resize": { "duration_ms": 360, "shader": true }
      }
    },
    {
      "id": "opening-and-resize-off",
      "meaning": "Off emits an explicit disabling node; a preserved movement or pointer contributes no stock node.",
      "document": {
        "kind": "profile",
        "schema": 2,
        "name": "Quiet opening",
        "actions": {
          "open": "off",
          "close": { "family": "pixels", "close_ms": 450 },
          "resize": "off",
          "movement": null
        },
        "pointer": null
      },
      "normalized": {
        "schema": 2,
        "actions": {
          "open": "off",
          "close": { "family": "pixels", "close_ms": 450 },
          "resize": "off",
          "movement": null
        }
      },
      "absent": ["pointer", "motion"],
      "stock_actions": {
        "window-open": { "off": true },
        "window-close": { "duration_ms": 450, "shader": true },
        "window-resize": { "off": true }
      }
    },
    {
      "id": "portable-native-style",
      "meaning": "Movement and pointer styles survive import while a stock export omits both experimental settings.",
      "document": {
        "kind": "profile",
        "schema": 2,
        "name": "Portable motion",
        "actions": {
          "open": { "family": "fragments", "open_ms": 700 },
          "close": null,
          "resize": null,
          "movement": { "family": "elastic", "movement_ms": 350 }
        },
        "pointer": { "strength": 0.4, "damping": 85, "frequency": 10 }
      },
      "normalized": {
        "schema": 2,
        "actions": {
          "open": { "family": "fragments", "open_ms": 700 },
          "close": null,
          "resize": null,
          "movement": { "family": "elastic", "movement_ms": 350 }
        },
        "pointer": { "strength": 0.4, "damping": 85, "frequency": 10 }
      },
      "absent": ["motion"],
      "stock_actions": { "window-open": { "duration_ms": 700, "shader": true } }
    }
  ],
