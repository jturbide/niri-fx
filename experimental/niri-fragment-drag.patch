+#[test]
+fn fragment_motion_input_requires_display_renderer_verification() {
+    use crate::render_helpers::RenderTarget;
+    for verification in [
+        None,
+        Some((RenderTarget::ScreenCapture, true)),
+        Some((RenderTarget::Screencast, true)),
+        Some((RenderTarget::Output, false)),
+        Some((RenderTarget::Output, true)),
+    ] {
+        let mut layout = fragment_input_layout();
+        if let Some((target, ready)) = verification {
+            fragment_input_tile(&layout).record_fragment_renderer(target, ready);
+        }
+        let expected = verification == Some((RenderTarget::Output, true));
+        let (output, pointer) = fragment_input_pointer(&layout);
+        assert_eq!(layout.fragment_move_press(&1, &output, pointer), expected);
+        assert_eq!(
+            fragment_input_tile(&layout)
+                .fragment_motion
+                .borrow()
+                .is_some(),
+            expected
+        );
+        Op::InteractiveMoveBegin {
+            window: 1,
+            output_idx: 1,
+            px: pointer.x,
+            py: pointer.y,
+        }
+        .apply(&mut layout);
+        Op::InteractiveMoveUpdate {
+            window: 1,
+            dx: 9.,
+            dy: 0.,
+            output_idx: 1,
+            px: pointer.x + 9.,
+            py: pointer.y,
+        }
+        .apply(&mut layout);
+        assert_eq!(
+            layout.interactive_move.as_ref().unwrap().moving().is_some(),
+            expected,
