+
+impl FragmentMotion {
+    fn valid(&self) -> bool {
+        (1..=4096).contains(&self.batches)
+            && self.delay_near_ms <= self.delay_far_ms
+            && self.delay_far_ms <= 600
+            && (20..=800).contains(&self.response_near_ms)
+            && (self.response_near_ms..=800).contains(&self.response_far_ms)
+            && self.distance_exponent.0 > 0.
+            && (1..=1024).contains(&self.max_lag)
+            && (20..=800).contains(&self.press_response_ms)
