+#[test]
+fn fragment_motion_marker_arbitrates_pointer_and_off_retires_state() {
+    let mut clock = Clock::with_time(Duration::ZERO);
+    let mut options = Options::default();
+    options.animations.window_movement.custom_shader = Some(format!(
+        "{}\n// nirifx-fragment-grid: 800 28",
+        crate::animation::fragment_motion::MARKER
+    ));
+    options.animations.window_movement.pointer_wobble = Some(Default::default());
+    let mut tile = Tile::new(
+        TestWindow::new(TestWindowParams::new(1)),
+        (1000., 800.).into(),
+        1.,
+        clock.clone(),
+        Rc::new(options.clone()),
+    );
+    tile.record_fragment_renderer(crate::render_helpers::RenderTarget::Output, true);
+    tile.begin_pointer_wobble((0.2, 0.4));
+    assert!(
+        tile.pointer_wobble.is_none(),
+        "whole-sheet driver must not mask fragments"
+    );
+    tile.push_pointer_wobble((30., 10.).into());
+    assert!(tile.are_transitions_ongoing());
+    tile.release_pointer_wobble();
+    clock.set_unadjusted(Duration::from_millis(16));
+    tile.advance_animations();
+    assert!(tile.are_transitions_ongoing());
+    options.animations.window_movement.anim.off = true;
+    tile.update_config((1000., 800.).into(), 1., Rc::new(options.clone()));
+    assert!(!tile.are_transitions_ongoing());
+    tile.begin_pointer_wobble((0.2, 0.4));
+    assert!(
+        tile.pointer_wobble.is_some(),
+        "timed Off retains independent pointer style"
+    );
+    options.animations.off = true;
+    tile.update_config((1000., 800.).into(), 1., Rc::new(options));
+    assert!(tile.pointer_wobble.is_none());
+    assert!(!tile.are_transitions_ongoing());
+}
