+#[test]
+fn fragment_motion_first_step_preserves_world_followers_and_pins_cursor() {
+    for floating in [false, true] {
+        let mut options = make_options();
+        options.animations.window_movement.custom_shader = Some(format!(
+            "{}\n// nirifx-fragment-grid: 800 28",
+            crate::animation::fragment_motion::MARKER
+        ));
+        let mut layout = check_ops_with_options(
+            options,
+            [
+                Op::AddOutput(1),
+                Op::AddWindow {
+                    params: TestWindowParams::new(1),
+                },
+                Op::Communicate(1),
+                Op::CompleteAnimations,
+            ],
+        );
+        if floating {
+            Op::ToggleWindowFloating { id: Some(1) }.apply(&mut layout);
+        }
+        Op::CompleteAnimations.apply(&mut layout);
+        let (before, pointer) = layout
+            .monitors()
+            .find_map(|mon| {
+                mon.workspaces_with_render_geo().find_map(|(ws, geo)| {
+                    ws.tiles_with_render_positions()
+                        .find(|(tile, _, _)| *tile.window().id() == 1)
+                        .map(|(tile, pos, _)| {
+                            tile.record_fragment_renderer(
+                                crate::render_helpers::RenderTarget::Output,
+                                true,
+                            );
+                            let base = geo.loc + pos;
+                            (
+                                base,
+                                base + tile.window_loc()
+                                    + tile.window_size().to_point().downscale(2.),
+                            )
+                        })
+                })
+            })
+            .unwrap();
+        Op::InteractiveMoveBegin {
+            window: 1,
+            output_idx: 1,
+            px: pointer.x,
+            py: pointer.y,
+        }
+        .apply(&mut layout);
+        Op::InteractiveMoveUpdate {
+            window: 1,
+            dx: 5.,
+            dy: 0.,
+            output_idx: 1,
+            px: pointer.x + 5.,
+            py: pointer.y,
+        }
+        .apply(&mut layout);
+        let move_ = layout
+            .interactive_move
+            .as_ref()
+            .unwrap()
+            .moving()
+            .expect("marked fragments detach on the first small motion");
+        let base = move_.tile_render_location(1.);
+        assert!((base.x - before.x - 5.).abs() < 1e-8);
+        assert!((base.y - before.y).abs() < 1e-8);
+        assert_eq!(move_.tile.render_offset(), (0., 0.).into());
+        let state = move_.tile.fragment_motion.borrow();
+        let sample = state
+            .as_ref()
+            .unwrap()
+            .borrow_mut()
+            .sample(
+                layout.clock.now(),
+                move_.tile.animated_tile_size(),
+                Rectangle::from_size(move_.tile.animated_tile_size()),
+            )
+            .unwrap();
+        for cell in sample.cells.iter().filter(|cell| cell.pin_weight == 0.) {
+            assert!((base.x + f64::from(cell.translation[0]) - before.x).abs() < 1e-8);
+            assert_eq!(cell.translation[1], 0.);
+        }
+        drop(state);
+        Op::InteractiveMoveEnd { window: 1 }.apply(&mut layout);
+        Op::AdvanceAnimations { msec_delta: 2100 }.apply(&mut layout);
+        assert!(layout.interactive_move.is_none());
