+
+fn mesh_projection(projection: Mat3, texture: Mat3, destination: Rectangle<i32, Physical>) -> Mat3 {
+    projection
+        * Mat3::from_translation(Vec2::new(
+            destination.loc.x as f32,
+            destination.loc.y as f32,
+        ))
+        * texture.inverse()
+}
+
+/// Niri's output transforms rotate/reflect axis-aligned damage. Project every
+/// corner into the GL viewport so damage remains correct on rotated outputs.
+fn mesh_damage_scissor(
+    projection: Mat3,
+    viewport: [i32; 4],
+    dest: Rectangle<i32, Physical>,
+    damage: Rectangle<i32, Physical>,
+) -> Option<[i32; 4]> {
+    let damage = damage.intersection(Rectangle::from_size(dest.size))?;
+    let mut low = Vec2::splat(f32::INFINITY);
+    let mut high = Vec2::splat(f32::NEG_INFINITY);
+    for x in [damage.loc.x, damage.loc.x + damage.size.w] {
+        for y in [damage.loc.y, damage.loc.y + damage.size.h] {
+            let ndc = projection
+                .transform_point2(Vec2::new((dest.loc.x + x) as f32, (dest.loc.y + y) as f32));
+            let pixel = Vec2::new(viewport[0] as f32, viewport[1] as f32)
+                + (ndc + Vec2::ONE) * 0.5 * Vec2::new(viewport[2] as f32, viewport[3] as f32);
+            low = low.min(pixel);
+            high = high.max(pixel);
+        }
+    }
+    // Projection roundoff must not expand neighboring damage rectangles onto
+    // the same pixel, which would apply premultiplied alpha twice at their seam.
+    let low = low.round();
+    let high = high.round();
+    intersect_scissors(
+        [
+            low.x as i32,
+            low.y as i32,
+            (high.x - low.x) as i32,
+            (high.y - low.y) as i32,
+        ],
+        viewport,
+    )
