+    #[test]
+    fn idle_shortcut_matches_original_replay_at_cutoffs_and_extreme_controls() {
+        // Retain the old bounded replay as an independent differential oracle.
+        // It deliberately does not call exactly_stationary() or the new shortcut.
+        fn original_advance(state: &mut FragmentMotion, now: Duration) {
+            let done = state.released_at.is_some_and(|at| {
+                now.saturating_sub(at)
+                    >= Duration::from_millis(u64::from(state.config.release_ms)).min(MAX_RELEASE)
+            });
+            if done {
+                for cell in state.cells.values_mut() {
+                    cell.position.finish(state.target);
+                    cell.spread.finish((0., 0.).into());
+                    cell.rotation.finish((0., 0.).into());
+                    cell.tilt.finish((0., 0.).into());
+                }
+            } else {
+                let mut cursor = state.sampled_at;
+                if now.saturating_sub(cursor) > MAX_RELEASE {
+                    let recent = now - MAX_RELEASE;
+                    for cell in state.cells.values_mut() {
+                        cell.advance_linear_history(
+                            state.target,
+                            &state.history,
+                            cursor,
+                            recent,
+                            state.held,
+                            state.config,
+                        );
+                    }
+                    cursor = recent;
+                }
+                while cursor < now {
+                    let next = (cursor + HISTORY_QUANTUM).min(now);
+                    for cell in state.cells.values_mut() {
+                        cell.advance(
+                            state.target,
+                            &state.history,
+                            cursor,
+                            (next - cursor).as_secs_f64(),
+                            state.held,
+                            state.config,
+                        );
+                    }
+                    cursor = next;
+                }
+            }
+            state.sampled_at = now;
+        }
+        let extreme = Config {
+            delay_near_ms: 600,
+            delay_far_ms: 600,
+            delay_jitter: niri_config::FloatOrInt(0.),
+            response_near_ms: 800,
+            response_far_ms: 800,
+            response_jitter: niri_config::FloatOrInt(0.),
+            press_response_ms: 800,
+            rotation_response_ms: 800,
+            rotation_degrees: niri_config::FloatOrInt(60.),
+            tilt: niri_config::FloatOrInt(1.1),
+            max_lag: 1024,
+            release_ms: 2000,
+            ..Default::default()
+        };
+        let size = (252., 224.).into();
+        let rect = Rectangle::from_size(size);
+        for config in [Config::default(), extreme] {
+            for phase in ["active-held", "settled-held", "active-release"] {
+                let mut initial = FragmentMotion::new(at(0));
+                initial.configure(
+                    config,
+                    FragmentGrid {
+                        particles: 0,
+                        tile: 28.,
+                    },
+                );
+                initial.grab((0.5, 0.1).into(), at(0));
+                initial.sample(at(0), size, rect).unwrap();
+                initial.push((100., -20.).into(), at(0));
+                initial.push((-20., 80.).into(), at(100));
+                initial.advance(at(160));
+                if phase == "settled-held" {
+                    original_advance(&mut initial, at(12_000));
+                    assert!(initial.exactly_stationary(at(12_000)));
+                } else if phase == "active-release" {
+                    initial.release(at(160));
+                }
+                for gap in [
+                    1,
+                    1999,
+                    2000,
+                    2001,
+                    2399,
+                    2400,
+                    2600,
+                    3000,
+                    4000,
+                    8000,
+                    24 * 60 * 60 * 1000,
+                ] {
+                    let now = initial.sampled_at + at(gap);
+                    let mut old = initial.clone();
+                    let mut new = initial.clone();
+                    original_advance(&mut old, now);
+                    new.advance(now);
+                    assert_same_pose(
+                        &old.sample(now, size, rect).unwrap(),
+                        &new.sample(now, size, rect).unwrap(),
+                    );
+                    for (a, b) in old.cells.values().zip(new.cells.values()) {
+                        for (a, b) in [
+                            (a.position, b.position),
+                            (a.spread, b.spread),
+                            (a.rotation, b.rotation),
+                            (a.tilt, b.tilt),
+                            (a.pin, b.pin),
+                        ] {
+                            assert_eq!(a.value, b.value, "{phase}, gap {gap}");
+                            assert_eq!(a.velocity, b.velocity, "{phase}, gap {gap}");
+                        }
+                    }
+                    assert_eq!(old.active(now), new.active(now));
+                }
+            }
+        }
+    }
