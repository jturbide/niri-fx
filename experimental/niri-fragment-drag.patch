+    /// CPU-only benchmark using the real state and counted source cells.
+    /// Run: NIRIFX_FRAGMENT_BENCHMARK=/absolute/report.json cargo test --release
+    /// --locked --lib fragment_motion_benchmark -- --ignored --nocapture
+    #[test]
+    #[ignore = "release-only CPU benchmark; requires NIRIFX_FRAGMENT_BENCHMARK"]
+    fn fragment_motion_benchmark() {
+        use std::hint::black_box;
+        use std::time::Instant;
+
+        assert!(!cfg!(debug_assertions), "run this benchmark with --release");
+        let output = std::env::var("NIRIFX_FRAGMENT_BENCHMARK")
+            .expect("NIRIFX_FRAGMENT_BENCHMARK must name an output JSON file");
+        let stats = |mut values: Vec<f64>| {
+            values.sort_by(f64::total_cmp);
+            serde_json::json!({
+                "samples": values.len(),
+                "median_us": values[values.len() / 2],
+                "p95_us": values[((values.len() - 1) as f64 * 0.95).ceil() as usize],
+                "max_us": values[values.len() - 1],
+            })
+        };
+        let mut cases = Vec::new();
+        for (columns, rows) in [(25, 24), (32, 25), (40, 30), (64, 64)] {
+            let size = Size::from((f64::from(columns * 28), f64::from(rows * 28)));
+            let rect = Rectangle::from_size(size);
+            let prepare = || {
+                let mut state = FragmentMotion::with_anchor((0.5, 0.1).into(), at(0));
+                state.configure(
+                    Config::default(),
+                    FragmentGrid {
+                        particles: 0,
+                        tile: 28.,
+                    },
+                );
+                state.grab((0.5, 0.1).into(), at(0));
+                let sample = state.sample(at(0), size, rect).unwrap();
+                assert_eq!(sample.cells.len(), (columns * rows) as usize);
+                state
+            };
+            let mut ordinary = Vec::new();
+            for hz in [60_u64, 120] {
+                let mut push_us = Vec::new();
+                let mut sample_us = Vec::new();
+                for _ in 0..3 {
+                    let mut state = prepare();
+                    for frame in 1..=480 {
+                        let now = Duration::from_nanos(frame * 1_000_000_000 / hz);
+                        let delta = if frame % 120 < 60 { 2. } else { -2. };
+                        let start = Instant::now();
+                        state.push(black_box((delta, 0.5 * delta).into()), now);
+                        let push = start.elapsed().as_secs_f64() * 1e6;
+                        let start = Instant::now();
+                        let sample = state.sample(now, size, rect).unwrap();
+                        black_box(&sample);
+                        drop(sample);
+                        let sample = start.elapsed().as_secs_f64() * 1e6;
+                        // Exclude startup/warm-up, retain three identical traces.
+                        if frame > 120 {
+                            push_us.push(push);
+                            sample_us.push(sample);
+                        }
+                    }
+                }
+                ordinary.push(serde_json::json!({
+                    "input_hz": hz,
+                    "push_and_advance": stats(push_us),
+                    "sample_and_drop": stats(sample_us),
+                }));
+            }
+            let mut idle = Vec::new();
+            for settled in [false, true] {
+                let mut recovery_us = Vec::new();
+                for _ in 0..7 {
+                    let mut state = prepare();
+                    state.push((100., 20.).into(), at(0));
+                    if settled {
+                        state.advance(at(3000));
+                        assert!(!state.moving());
+                    }
+                    let start = Instant::now();
+                    state.advance(at(24 * 60 * 60 * 1000));
+                    black_box(&state);
+                    recovery_us.push(start.elapsed().as_secs_f64() * 1e6);
+                    assert!(!state.moving());
+                    assert!(state.held());
+                }
+                idle.push(serde_json::json!({
+                    "initially_settled": settled,
+                    "recovery": stats(recovery_us),
+                }));
+            }
+            cases.push(serde_json::json!({
+                "actual_cells": columns * rows,
+                "logical_size": [size.w, size.h],
+                "ordinary": ordinary,
+                "idle_24h": idle,
+            }));
+        }
+        let report = serde_json::json!({
+            "schema": 1,
+            "release_profile": true,
+            "scope": "CPU state advance and sample allocation only; no renderer or presentation timing",
+            "history_quantum_ms": HISTORY_QUANTUM.as_millis(),
+            "maximum_recent_replay_ms": MAX_RELEASE.as_millis(),
+            "ordinary_warmup_frames": 120,
+            "ordinary_measured_frames_per_repeat": 360,
+            "ordinary_repeats": 3,
+            "cases": cases,
+        });
+        std::fs::write(output, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+        println!("{report}");
+    }
+
+    /// The capacity stress restores discarded old entries from the same real
+    /// push trace. It exceeds production retention, not the allocation bound;
+    /// positions, velocities, target, timestamp and event quantization stay real.
+    fn dense_history_state(
+        config: Config,
+        size: Size<f64, Logical>,
+    ) -> (FragmentMotion, Vec<Target>, Vec<f64>) {
+        use std::time::Instant;
+        let mut state = FragmentMotion::with_anchor((0.5, 0.1).into(), at(0));
+        state.configure(
+            config,
+            FragmentGrid {
+                particles: 0,
+                tile: 28.,
+            },
+        );
+        state.grab((0.5, 0.1).into(), at(0));
+        state
+            .sample(at(0), size, Rectangle::from_size(size))
+            .unwrap();
+        let mut complete = state.history.clone();
+        let mut push_us = Vec::new();
+        for event in 1..HISTORY_LIMIT {
+            let delta = if event % 64 < 32 { 3. } else { -3. };
+            let start = Instant::now();
+            state.push((delta, -0.5 * delta).into(), at(event as u64 * 4));
+            push_us.push(start.elapsed().as_secs_f64() * 1e6);
+            complete.push(Target {
+                at: state.sampled_at,
+                position: state.target,
+            });
+        }
+        assert_eq!(state.history.len(), 154);
+        assert_eq!(complete.len(), HISTORY_LIMIT);
+        assert_eq!(complete.last().unwrap().position, state.target);
+        assert!(state.has_pending_target(state.sampled_at));
+        (state, complete, push_us)
+    }
+
+    #[test]
+    fn dense_history_retention_and_capacity_replay_preserve_the_same_pose() {
+        let size = (252., 224.).into();
+        let rect = Rectangle::from_size(size);
+        let (initial, complete, _) = dense_history_state(Config::default(), size);
+        assert_eq!(initial.history.first().unwrap().at, at(408));
+        assert_eq!(initial.history.last().unwrap().at, at(1020));
+        for gap in [1, 599, 600, 2001, 4000, 24 * 60 * 60 * 1000] {
+            let mut reachable = initial.clone();
+            let mut capacity = initial.clone();
+            capacity.history = complete.clone();
+            let now = initial.sampled_at + at(gap);
+            reachable.advance(now);
+            capacity.advance(now);
+            assert_same_pose(
+                &reachable.sample(now, size, rect).unwrap(),
+                &capacity.sample(now, size, rect).unwrap(),
+            );
+            for (a, b) in reachable.cells.values().zip(capacity.cells.values()) {
+                for (a, b) in [
+                    (a.position, b.position),
+                    (a.spread, b.spread),
+                    (a.rotation, b.rotation),
+                    (a.tilt, b.tilt),
+                    (a.pin, b.pin),
+                ] {
+                    assert_eq!(a.value, b.value, "gap {gap}");
+                    assert_eq!(a.velocity, b.velocity, "gap {gap}");
+                }
+            }
+            assert_eq!(reachable.active(now), capacity.active(now));
+        }
+    }
