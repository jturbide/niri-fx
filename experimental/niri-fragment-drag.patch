+                "samples_us": values,
+                "median_us": sorted[sorted.len() / 2],
+                "p95_us": sorted[((sorted.len() - 1) as f64 * 0.95).ceil() as usize],
+                "max_us": sorted[sorted.len() - 1],
+            })
+        };
+        let extreme = Config {
+            delay_near_ms: 600,
+            delay_far_ms: 600,
+            delay_jitter: niri_config::FloatOrInt(0.),
+            response_near_ms: 800,
+            response_far_ms: 800,
+            response_jitter: niri_config::FloatOrInt(0.),
+            press_response_ms: 800,
+            rotation_response_ms: 800,
+            rotation_degrees: niri_config::FloatOrInt(60.),
+            tilt: niri_config::FloatOrInt(1.1),
+            max_lag: 1024,
+            release_ms: 2000,
+            ..Default::default()
+        };
+        let mut cases = Vec::new();
+        for (columns, rows) in [(25, 24), (32, 25), (40, 30), (64, 64)] {
+            let size = Size::from((f64::from(columns * 28), f64::from(rows * 28)));
+            let rect = Rectangle::from_size(size);
+            for (config_name, config) in [("default", Config::default()), ("extreme", extreme)] {
+                let (initial, complete, push_us) = dense_history_state(config, size);
+                assert_eq!(initial.cells.len(), (columns * rows) as usize);
+                let mut recoveries = Vec::new();
+                for capacity in [false, true] {
+                    let mut initial = initial.clone();
+                    if capacity {
+                        initial.history = complete.clone();
+                    }
+                    for gap in [2001, 4000, 24 * 60 * 60 * 1000] {
+                        let now = initial.sampled_at + at(gap);
+                        let mut recovery_us = Vec::new();
+                        let mut moving = false;
+                        let mut exact_rest = false;
+                        for _ in 0..7 {
+                            // Allocation/copy and material export are outside the
+                            // recovery timing; advance is the measured workload.
+                            let mut state = initial.clone();
+                            let start = Instant::now();
+                            state.advance(black_box(now));
+                            black_box(&state);
+                            recovery_us.push(start.elapsed().as_secs_f64() * 1e6);
+                            moving = state.moving();
+                            exact_rest = state.exactly_stationary(now);
+                            assert!(state.held());
+                            let sample = state.sample(now, size, rect).unwrap();
+                            assert_eq!(sample.cells.len(), (columns * rows) as usize);
+                            for cell in sample.cells.iter() {
+                                assert!(cell
+                                    .translation
+                                    .iter()
+                                    .chain(cell.tilt.iter())
+                                    .all(|v| v.is_finite()));
+                                assert!(cell.rotation.is_finite());
+                            }
+                            if gap == 24 * 60 * 60 * 1000 {
+                                assert!(exact_rest);
+                            }
+                        }
+                        recoveries.push(serde_json::json!({
+                            "history_kind": if capacity { "synthetic_capacity" } else { "reachable_dense_input" },
+                            "retained_events": initial.history.len(),
+                            "oldest_event_ms": initial.history.first().unwrap().at.as_millis(),
+                            "latest_event_ms": initial.history.last().unwrap().at.as_millis(),
+                            "sampled_at_before_ms": initial.sampled_at.as_millis(),
+                            "gap_ms": gap, "moving_after": moving, "exact_rest_after": exact_rest,
+                            "advance": stats(recovery_us),
+                        }));
+                    }
+                }
+                cases.push(serde_json::json!({
+                    "actual_cells": columns * rows, "logical_size": [size.w, size.h],
+                    "config": config_name, "reachable_input_push_and_advance": stats(push_us),
+                    "recoveries": recoveries,
+                }));
+            }
+        }
+        let report = serde_json::json!({
+            "schema": 1, "release_profile": true,
+            "scope": "CPU-only state advance; no renderer, presentation, physical suspend or real-time latency claim",
+            "history_quantum_ms": HISTORY_QUANTUM.as_millis(),
+            "history_retention_ms": HISTORY_RETENTION.as_millis(), "history_limit": HISTORY_LIMIT,
+            "maximum_recent_replay_ms": MAX_RELEASE.as_millis(),
+            "input": {"hz": 250, "events": 255, "initial_rest_events": 1, "duration_ms": 1020,
+                "delta": [3., -1.5], "direction": "sign alternates each 32-event block"},
+            "capacity_stress": "Restores all 256 chronological entries of the same input trace, including entries production retention discarded; no state, target or event cadence changes. This is not a reachable steady-state input history.",
+            "controls": {"default": "native Config::default()",
+                "extreme": {"delay_near_ms": 600, "delay_far_ms": 600, "delay_jitter": 0,
+                    "response_near_ms": 800, "response_far_ms": 800, "response_jitter": 0,
+                    "press_response_ms": 800, "rotation_response_ms": 800, "rotation_degrees": 60,
+                    "tilt": 1.1, "max_lag": 1024, "release_ms": 2000,
+                    "other_fields": "native Config::default()"}},
+            "recovery_repeats": 7, "cases": cases,
+        });
+        std::fs::write(path, serde_json::to_vec_pretty(&report).unwrap()).unwrap();
+        println!(
+            "dense benchmark: {} cases, 48 recovery combinations",
+            cases.len()
+        );
+    }
+}
