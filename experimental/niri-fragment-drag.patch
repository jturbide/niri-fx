+fn intersect_scissors(a: [i32; 4], b: [i32; 4]) -> Option<[i32; 4]> {
+    let x = a[0].max(b[0]);
+    let y = a[1].max(b[1]);
+    let right = (a[0] + a[2]).min(b[0] + b[2]);
+    let top = (a[1] + a[3]).min(b[1] + b[3]);
+    (right > x && top > y).then_some([x, y, right - x, top - y])
