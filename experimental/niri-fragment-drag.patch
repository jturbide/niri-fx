+++ b/src/animation/fragment_motion.rs
@@ -0,0 +1,1686 @@
+//! Bounded world-space followers for the native square-fragment material.
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::rc::Rc;
+use std::time::Duration;
+
+use niri_config::animations::{FragmentMotion as Config, FragmentRotation};
+use smithay::utils::{Logical, Point, Rectangle, Size};
+
+pub const MARKER: &str = "// nirifx-fragment-motion: 3";
+const GRID_MARKER: &str = "// nirifx-fragment-grid: ";
+pub const MAX_LAG: f64 = 1024.;
+pub const MAX_CELLS: usize = 4096;
+const HISTORY_QUANTUM: Duration = Duration::from_millis(4);
+const HISTORY_LIMIT: usize = 256;
+const HISTORY_RETENTION: Duration = Duration::from_millis(608);
+const MAX_RELEASE: Duration = Duration::from_millis(2000);
+type Vector = Point<f64, Logical>;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct FragmentGrid {
+    pub particles: u32,
+    pub tile: f64,
+}
+
+impl Default for FragmentGrid {
+    fn default() -> Self {
+        Self {
+            particles: 800,
+            tile: 28.,
+        }
+    }
+}
+
+pub fn grid(source: &str) -> Option<FragmentGrid> {
+    if !source.lines().any(|line| line.trim() == MARKER) {
+        return None;
+    }
+    let mut matches = source
+        .lines()
+        .filter_map(|line| line.trim().strip_prefix(GRID_MARKER));
+    let mut words = matches.next()?.split_whitespace();
+    let particles: f64 = words.next()?.parse().ok()?;
+    let tile: f64 = words.next()?.parse().ok()?;
+    if words.next().is_some()
+        || matches.next().is_some()
+        || !particles.is_finite()
+        || particles.fract() != 0.
+        || !(0. ..=4096.).contains(&particles)
+        || !tile.is_finite()
+        || !(8. ..=128.).contains(&tile)
+    {
+        return None;
+    }
+    Some(FragmentGrid {
+        particles: particles as u32,
+        tile,
+    })
+}
+
+pub fn supported(source: &str) -> bool {
+    grid(source).is_some()
+}
+pub fn selected(compiled: Option<&str>, configured: Option<&str>) -> bool {
+    compiled.is_some_and(supported) && compiled == configured
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct FragmentCell {
+    pub center: [f32; 2],
+    pub half_extent: [f32; 2],
+    pub translation: [f32; 2],
+    pub rotation: f32,
+    /// Orthographic X/Y tilt angles, in radians.
+    pub tilt: [f32; 2],
+    pub edge_blend: f32,
+    pub pin_weight: f32,
+}
+#[derive(Debug, Clone)]
+pub struct FragmentSample {
+    pub cells: Rc<[FragmentCell]>,
+    pub max_lag: f64,
+}
+#[derive(Debug, Clone)]
+pub struct FragmentRenderState {
+    pub motion: Rc<RefCell<FragmentMotion>>,
+    pub at: Duration,
+}
+impl FragmentRenderState {
+    pub fn sample(
+        &self,
+        geo_size: Size<f64, Logical>,
+        texture_rect: Rectangle<f64, Logical>,
+    ) -> Result<FragmentSample, &'static str> {
+        self.motion
+            .borrow_mut()
+            .sample(self.at, geo_size, texture_rect)
+    }
+}
+#[derive(Debug, Clone, Copy)]
+pub struct FragmentLayout {
+    pub remaining: Vector,
+    pub velocity: Vector,
+    pub delta: Vector,
+    pub end: Duration,
+}
+#[derive(Debug, Clone)]
+struct LayoutSample {
+    remaining: Vector,
+    delta: Vector,
+    end: Duration,
+    at: Duration,
+}
+#[derive(Debug, Clone, Copy)]
+struct Target {
+    at: Duration,
+    position: Vector,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct Spring {
+    value: Vector,
+    velocity: Vector,
+}
+impl Spring {
+    fn advance(&mut self, target: Vector, seconds: f64, response_ms: f64) {
+        let omega = 3.889720169867429 / (response_ms / 1000.);
+        let lag = self.value - target;
+        let b = self.velocity + lag.upscale(omega);
+        let decay = (-omega * seconds).exp();
+        self.value = target + (lag + b.upscale(seconds)).upscale(decay);
+        self.velocity = (self.velocity - b.upscale(omega * seconds)).upscale(decay);
+        if norm(self.value - target) < 0.0001 && norm(self.velocity) < 0.001 {
+            self.value = target;
+            self.velocity = (0., 0.).into();
+        }
+    }
+    fn finish(&mut self, target: Vector) {
+        self.value = target;
+        self.velocity = (0., 0.).into();
+    }
+}
+fn norm(v: Vector) -> f64 {
+    v.x.hypot(v.y)
+}
+fn limited(v: Vector, bound: f64) -> Vector {
+    v.upscale((bound / norm(v).max(bound)).min(1.))
+}
+fn hash(id: (i32, i32), salt: u64) -> f64 {
+    let mut x = ((id.0 as u32 as u64) << 32) ^ id.1 as u32 as u64 ^ salt;
+    x ^= x >> 30;
+    x = x.wrapping_mul(0xbf58476d1ce4e5b9);
+    x ^= x >> 27;
+    x = x.wrapping_mul(0x94d049bb133111eb);
+    x ^= x >> 31;
+    (x >> 11) as f64 / ((1u64 << 53) as f64)
+}
+fn target_at(history: &[Target], at: Duration) -> Vector {
+    let index = history
+        .partition_point(|event| event.at <= at)
+        .saturating_sub(1);
+    history[index].position
+}
+
+#[derive(Debug, Clone)]
+struct Particle {
+    id: (i32, i32),
+    center: Vector,
+    half: f64,
+    position: Spring,
+    spread: Spring,
+    rotation: Spring,
+    tilt: Spring,
+    pin: Spring,
+    pin_target: bool,
+    radial: Vector,
+    delay: Duration,
+    response_ms: f64,
+}
+impl Particle {
+    fn configure(&mut self, anchor: Vector, size: Size<f64, Logical>, config: Config, fresh: bool) {
+        let offset = self.center - anchor;
+        let distance = norm(offset);
+        let corner = anchor
+            .x
+            .max(size.w - anchor.x)
+            .hypot(anchor.y.max(size.h - anchor.y))
+            .max(1.);
+        let radius = ((distance - config.pin_radius.0).max(0.) / corner)
+            .clamp(0., 1.)
+            .powf(config.distance_exponent.0);
+        let bins = f64::from(config.batches.max(1));
+        let wave = ((radius * bins).floor() / bins).clamp(0., 1.);
+        let jitter = (hash(self.id, 1) * 2. - 1.) * config.delay_jitter.0;
+        let delay = (f64::from(config.delay_near_ms)
+            + f64::from(config.delay_far_ms - config.delay_near_ms) * wave)
+            * (1. + jitter);
+        self.delay = Duration::from_secs_f64(delay.clamp(0., 600.) / 1000.);
+        let response = f64::from(config.response_near_ms)
+            + f64::from(config.response_far_ms - config.response_near_ms) * radius;
+        self.response_ms = (response
+            * (1. + (hash(self.id, 2) * 2. - 1.) * config.response_jitter.0))
+            .clamp(20., 800.);
+        // Cell rectangle distance guarantees the actual grabbed cell stays pinned.
+        let cell_distance = (offset.x.abs() - self.half)
+            .max(0.)
+            .hypot((offset.y.abs() - self.half).max(0.));
+        self.pin_target = cell_distance <= config.pin_radius.0;
+        self.radial = offset.downscale(distance.max(1.)).upscale(radius.sqrt());
+        if fresh {
+            self.pin
+                .finish((if self.pin_target { 1. } else { 0. }, 0.).into());
+        }
+    }
+    fn advance_linear_history(
+        &mut self,
+        target: Vector,
+        history: &[Target],
+        start: Duration,
+        end: Duration,
+        held: bool,
+        config: Config,
+    ) {
+        let mut cursor = start;
+        let mut goal = start
+            .checked_sub(self.delay)
+            .map_or(history[0].position, |at| target_at(history, at));
+        for event in history {
+            let due = event.at + self.delay;
+            if due <= start || due >= end {
+                continue;
+            }
+            self.position
+                .advance(goal, (due - cursor).as_secs_f64(), self.response_ms);
+            cursor = due;
+            goal = event.position;
+        }
+        self.position
+            .advance(goal, (end - cursor).as_secs_f64(), self.response_ms);
+        let dt = (end - start).as_secs_f64();
+        if self.pin.value.x == 1. && self.pin_target {
+            self.position.finish(target);
+        }
+        self.pin
+            .advance((if self.pin_target { 1. } else { 0. }, 0.).into(), dt, 80.);
+        self.spread.advance(
+            self.radial
+                .upscale(if held { config.press_spread.0 } else { 0. }),
+            dt,
+            f64::from(config.press_response_ms),
+        );
+        // Older angular forcing is outside the retained simulation horizon.
+        // Two seconds of following integration below suppresses its bounded
+        // residual while linear world position and velocity remain analytic.
+        self.rotation
+            .advance((0., 0.).into(), dt, f64::from(config.rotation_response_ms));
+        self.tilt
+            .advance((0., 0.).into(), dt, f64::from(config.rotation_response_ms));
+    }
+
+    fn advance(
+        &mut self,
+        target: Vector,
+        history: &[Target],
+        at: Duration,
+        dt: f64,
+        held: bool,
+        config: Config,
+    ) {
+        let delayed = at
+            .checked_sub(self.delay)
+            .map_or(history[0].position, |at| target_at(history, at));
+        self.position.advance(delayed, dt, self.response_ms);
+        if self.pin.value.x == 1. && self.pin_target {
+            self.position.finish(target);
+        }
+        self.pin
+            .advance((if self.pin_target { 1. } else { 0. }, 0.).into(), dt, 80.);
+        let spread = self
+            .radial
+            .upscale(if held { config.press_spread.0 } else { 0. });
+        self.spread
+            .advance(spread, dt, f64::from(config.press_response_ms));
+        let velocity = self.position.velocity + self.spread.velocity;
+        let speed = norm(velocity);
+        let reference = f64::from(config.rotation_speed);
+        let axis: Vector = match config.rotation_mode {
+            FragmentRotation::Movement => (-self.radial.y, self.radial.x).into(),
+            FragmentRotation::Random => {
+                let angle = hash(self.id, 3) * std::f64::consts::TAU;
+                (angle.cos(), angle.sin()).into()
+            }
+            FragmentRotation::None => (0., 0.).into(),
+        };
+        let signed = (velocity.x * axis.x + velocity.y * axis.y)
+            / (speed * speed + reference * reference).sqrt();
+        let angle = signed * config.rotation_degrees.0.to_radians();
+        self.rotation.advance(
+            (angle, 0.).into(),
+            dt,
+            f64::from(config.rotation_response_ms),
+        );
+        let tilt = Vector::from((-velocity.y, velocity.x))
+            .upscale(config.tilt.0 / (speed * speed + reference * reference).sqrt());
+        self.tilt
+            .advance(tilt, dt, f64::from(config.rotation_response_ms));
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct FragmentMotion {
+    config: Config,
+    grid: FragmentGrid,
+    pending_config: Option<(Config, FragmentGrid)>,
+    failed: bool,
+    sampled_at: Duration,
+    held: bool,
+    layout: Option<LayoutSample>,
+    released_at: Option<Duration>,
+    target: Vector,
+    history: Vec<Target>,
+    anchor: Vector,
+    geometry: Option<(Size<f64, Logical>, f64, Vector)>,
+    cells: BTreeMap<(i32, i32), Particle>,
+}
+impl FragmentMotion {
+    pub fn new(now: Duration) -> Self {
+        Self::with_anchor((0.5, 0.5).into(), now)
+    }
+    pub fn with_anchor(anchor: Vector, now: Duration) -> Self {
+        Self {
+            config: Config::default(),
+            grid: FragmentGrid::default(),
+            pending_config: None,
+            failed: false,
+            sampled_at: now,
+            held: false,
+            layout: None,
+            released_at: None,
+            target: (0., 0.).into(),
+            history: vec![Target {
+                at: now,
+                position: (0., 0.).into(),
+            }],
+            anchor,
+            geometry: None,
+            cells: BTreeMap::new(),
+        }
+    }
+    pub fn configure(&mut self, config: Config, grid: FragmentGrid) {
+        if self.config == config && self.grid == grid {
+            self.pending_config = None;
+            return;
+        }
+        // A release envelope and its lag clamp are part of the displayed pose.
+        // Replacing either mid-episode would jump or re-expand that pose. Keep
+        // the latest request for the next fully settled episode, including grid
+        // density, rather than reinterpret existing particles with new controls.
+        self.pending_config = Some((config, grid));
+        self.apply_pending_if_settled(self.sampled_at);
+    }
+    fn apply_pending_if_settled(&mut self, now: Duration) {
+        if self.active(now) {
+            return;
+        }
+        if self.pending_config.is_none() && !self.failed {
+            return;
+        }
+        if let Some((config, grid)) = self.pending_config.take() {
+            self.config = config;
+            self.grid = grid;
+        }
+        self.geometry = None;
+        self.cells.clear();
+        self.target = (0., 0.).into();
+        self.history.clear();
+        self.history.push(Target {
+            at: now,
+            position: self.target,
+        });
+        self.released_at = None;
+        self.layout = None;
+        self.failed = false;
+    }
+    /// Stop a failed preparation once while preserving grab/layout ownership.
+    /// The caller renders its current target through the ordinary protected path.
+    pub fn fail(&mut self) {
+        self.failed = true;
+        self.cells.clear();
+        self.geometry = None;
+        self.history.truncate(1);
+    }
+    pub fn failed(&self) -> bool {
+        self.failed
+    }
+    fn envelope(&self, now: Duration) -> (f64, f64) {
+        let Some(start) = self.released_at else {
+            return (1., 0.);
+        };
+        let duration = f64::from(self.config.release_ms) / 1000.;
+        let taper = duration.min(0.4);
+        let t =
+            ((now.saturating_sub(start).as_secs_f64() - (duration - taper)) / taper).clamp(0., 1.);
+        (
+            1. - t.powi(3) * (10. - 15. * t + 6. * t * t),
+            -30. * t * t * (1. - t) * (1. - t) / taper,
+        )
+    }
+    fn resume(&mut self, now: Duration) {
+        if self.released_at.is_none() {
+            return;
+        }
+        let (e, d) = self.envelope(now);
+        for cell in self.cells.values_mut() {
+            let lag = limited(
+                cell.position.value - self.target,
+                f64::from(self.config.max_lag),
+            );
+            cell.position.value = self.target + lag.upscale(e);
+            cell.position.velocity = cell.position.velocity.upscale(e) + lag.upscale(d);
+            for spring in [&mut cell.spread, &mut cell.rotation, &mut cell.tilt] {
+                spring.velocity = spring.velocity.upscale(e) + spring.value.upscale(d);
+                spring.value = spring.value.upscale(e);
+            }
+        }
+        self.released_at = None;
+    }
+    pub fn grab(&mut self, anchor: Vector, now: Duration) {
+        self.advance(now);
+        self.apply_pending_if_settled(now);
+        self.resume(now);
+        self.held = true;
+        self.layout = None;
+        self.anchor = anchor;
+        if let Some((size, _, _)) = self.geometry {
+            let anchor = (anchor.x * size.w, anchor.y * size.h).into();
+            let fresh = !self.moving();
+            for cell in self.cells.values_mut() {
+                cell.configure(anchor, size, self.config, fresh);
+            }
+        }
+    }
+    pub fn push(&mut self, delta: Vector, now: Duration) {
+        if self.failed {
+            return;
+        }
+        if !delta.x.is_finite() || !delta.y.is_finite() {
+            return;
+        }
+        self.advance(now);
+        if delta == (0., 0.).into() {
+            return;
+        }
+        self.resume(now);
+        self.target += (delta.x.clamp(-1e6, 1e6), delta.y.clamp(-1e6, 1e6)).into();
+        let event = Target {
+            at: now,
+            position: self.target,
+        };
+        // Keep the initial rest sample. Coalesce only subsequent events within
+        // a 4ms bucket, bounding high-rate devices to 256 history entries.
+        if self.history.len() > 1
+            && self.history.last().unwrap().at.as_millis() / 4 == now.as_millis() / 4
+        {
+            self.history.last_mut().unwrap().position = self.target;
+        } else {
+            self.history.push(event);
+        }
+        let cutoff = now.saturating_sub(HISTORY_RETENTION);
+        let keep = self
+            .history
+            .partition_point(|event| event.at < cutoff)
+            .saturating_sub(1);
+        if keep > 0 {
+            self.history.drain(..keep);
+        }
+        if self.history.len() > HISTORY_LIMIT {
+            self.history.drain(..self.history.len() - HISTORY_LIMIT);
+        }
+    }
+    pub fn release(&mut self, now: Duration) {
+        self.advance(now);
+        self.held = false;
+        self.layout = None;
+        self.settle(now);
+    }
+    fn settle(&mut self, now: Duration) {
+        self.released_at.get_or_insert(now);
+    }
+    pub fn held(&self) -> bool {
+        self.held
+    }
+    pub fn layout(&mut self, sample: Option<FragmentLayout>, now: Duration) {
+        if self.held {
+            return;
+        }
+        if let Some(FragmentLayout {
+            remaining,
+            velocity,
+            delta,
+            end,
+        }) = sample
+        {
+            if let Some(previous) = &self.layout {
+                if now <= previous.at {
+                    return;
+                }
+                let travel = if previous.end == end && previous.delta == delta {
+                    previous.remaining - remaining
+                } else {
+                    velocity.upscale(now.saturating_sub(previous.at).as_secs_f64().min(0.05))
+                };
+                self.push(travel, now);
+            } else {
+                self.advance(now);
+                self.apply_pending_if_settled(now);
+                self.resume(now);
+            }
+            self.layout = Some(LayoutSample {
+                remaining,
+                delta,
+                end,
+                at: now,
+            });
+        } else if self.layout.take().is_some() {
+            self.settle(now);
+        }
+    }
+    pub fn advance(&mut self, now: Duration) {
+        if now <= self.sampled_at {
+            return;
+        }
+        if self.failed {
+            self.sampled_at = now;
+            return;
+        }
+        if !self.held && self.layout.as_ref().is_some_and(|sample| now >= sample.end) {
+            self.settle(self.layout.as_ref().unwrap().end);
+        }
+        let done = self.released_at.is_some_and(|at| {
+            now.saturating_sub(at)
+                >= Duration::from_millis(u64::from(self.config.release_ms)).min(MAX_RELEASE)
+        });
+        if done {
+            for cell in self.cells.values_mut() {
+                cell.position.finish(self.target);
+                cell.spread.finish((0., 0.).into());
+                cell.rotation.finish((0., 0.).into());
+                cell.tilt.finish((0., 0.).into());
+            }
+        } else {
+            let mut cursor = self.sampled_at;
+            if now.saturating_sub(cursor) > MAX_RELEASE {
+                let recent = now - MAX_RELEASE;
+                for cell in self.cells.values_mut() {
+                    cell.advance_linear_history(
+                        self.target,
+                        &self.history,
+                        cursor,
+                        recent,
+                        self.held,
+                        self.config,
+                    );
+                }
+                cursor = recent;
+                // After a long idle, the analytic prefix often reaches exact
+                // spring rest. With no delayed target left, every remaining
+                // slice would reproduce these same values and zero velocities.
+                // Do not use moving()'s visual thresholds here: even tiny angular
+                // residue or a still-queued out-and-back pulse must be replayed.
+                if self.exactly_stationary(cursor) {
+                    self.sampled_at = now;
+                    return;
+                }
+            }
+            // Bounded integration slices also make changing velocity-driven tilt
+            // stable at ordinary display rates. Capture passes share this clock.
+            while cursor < now {
+                let next = (cursor + HISTORY_QUANTUM).min(now);
+                let dt = (next - cursor).as_secs_f64();
+                for cell in self.cells.values_mut() {
+                    cell.advance(
+                        self.target,
+                        &self.history,
+                        cursor,
+                        dt,
+                        self.held,
+                        self.config,
+                    );
+                }
+                cursor = next;
+            }
+        }
+        self.sampled_at = now;
+    }
+    pub fn moving(&self) -> bool {
+        if self.failed {
+            return false;
+        }
+        if self.released_at.is_some_and(|at| {
+            self.sampled_at.saturating_sub(at)
+                >= Duration::from_millis(u64::from(self.config.release_ms))
+        }) {
+            return false;
+        }
+        // A brief out-and-back target pulse can leave every visible position
+        // at rest while distant cells still owe their delayed response.
+        if self.has_pending_target(self.sampled_at) {
+            return true;
+        }
+        if self.cells.is_empty() {
+            return self.held;
+        }
+        self.cells.values().any(|cell| {
+            norm(cell.position.value - self.target) > 0.001
+                || norm(cell.position.velocity) > 0.01
+                || norm(
+                    cell.spread.value
+                        - cell.radial.upscale(if self.held {
+                            self.config.press_spread.0
+                        } else {
+                            0.
+                        }),
+                ) > 0.001
+                || norm(cell.spread.velocity) > 0.01
+                || norm(cell.rotation.value) > 0.0001
+                || norm(cell.rotation.velocity) > 0.001
+                || norm(cell.tilt.value) > 0.0001
+                || norm(cell.tilt.velocity) > 0.001
+        })
+    }
+    pub fn active(&self, now: Duration) -> bool {
+        self.held || self.moving() || self.layout.as_ref().is_some_and(|s| now < s.end)
+    }
+    fn has_pending_target(&self, at: Duration) -> bool {
+        let max_delay =
+            (f64::from(self.config.delay_far_ms) * (1. + self.config.delay_jitter.0)).min(600.);
+        self.history.len() > 1
+            && at < self.history.last().unwrap().at + Duration::from_secs_f64(max_delay / 1000.)
+    }
+    fn exactly_stationary(&self, at: Duration) -> bool {
+        let zero = (0., 0.).into();
+        !self.cells.is_empty()
+            && !self.has_pending_target(at)
+            && self.cells.values().all(|cell| {
+                cell.position.value == self.target
+                    && cell.position.velocity == zero
+                    && cell.spread.value
+                        == cell.radial.upscale(if self.held {
+                            self.config.press_spread.0
+                        } else {
+                            0.
+                        })
+                    && cell.spread.velocity == zero
+                    && cell.rotation.value == zero
+                    && cell.rotation.velocity == zero
+                    && cell.tilt.value == zero
+                    && cell.tilt.velocity == zero
+                    && cell.pin.value == (if cell.pin_target { 1. } else { 0. }, 0.).into()
+                    && cell.pin.velocity == zero
+            })
+    }
+    fn ensure_grid(
+        &mut self,
+        size: Size<f64, Logical>,
+        rect: Rectangle<f64, Logical>,
+    ) -> Result<(), &'static str> {
+        if ![
+            size.w,
+            size.h,
+            rect.loc.x,
+            rect.loc.y,
+            rect.size.w,
+            rect.size.h,
+        ]
+        .into_iter()
+        .all(f64::is_finite)
+            || size.w <= 0.
+            || size.h <= 0.
+            || rect.size.w <= 0.
+            || rect.size.h <= 0.
+        {
+            return Err("invalid fragment geometry");
+        }
+        let (size, tile, origin) = *self.geometry.get_or_insert_with(|| {
+            let tile = if self.grid.particles > 0 {
+                (size.w * size.h / f64::from(self.grid.particles))
+                    .sqrt()
+                    .max(4.)
+            } else {
+                self.grid.tile
+            };
+            let origin = (
+                (size.w - (size.w / tile).ceil() * tile) * 0.5,
+                (size.h - (size.h / tile).ceil() * tile) * 0.5,
+            )
+                .into();
+            (size, tile, origin)
+        });
+        let x0 = ((rect.loc.x - origin.x) / tile).floor() as i64;
+        let y0 = ((rect.loc.y - origin.y) / tile).floor() as i64;
+        let x1 = ((rect.loc.x + rect.size.w - origin.x) / tile).ceil() as i64;
+        let y1 = ((rect.loc.y + rect.size.h - origin.y) / tile).ceil() as i64;
+        let count = (x1 - x0)
+            .checked_mul(y1 - y0)
+            .ok_or("fragment grid overflow")?;
+        if count < 1
+            || count > MAX_CELLS as i64
+            || [x0, y0, x1, y1]
+                .into_iter()
+                .any(|v| v < i32::MIN as i64 || v > i32::MAX as i64)
+        {
+            return Err("fragment grid exceeds cell limit");
+        }
+        let mut additions = Vec::new();
+        additions
+            .try_reserve(count as usize)
+            .map_err(|_| "fragment allocation failed")?;
+        for y in y0..y1 {
+            for x in x0..x1 {
+                let id = (x as i32, y as i32);
+                if !self.cells.contains_key(&id) {
+                    additions.push(id);
+                }
+            }
+        }
+        if self.cells.len() + additions.len() > MAX_CELLS {
+            return Err("retained fragment grid exceeds cell limit");
+        }
+        let anchor = (self.anchor.x * size.w, self.anchor.y * size.h).into();
+        let first_grid = self.cells.is_empty();
+        for id in additions {
+            let center = origin
+                + Vector::from((
+                    (f64::from(id.0) + 0.5) * tile,
+                    (f64::from(id.1) + 0.5) * tile,
+                ));
+            let mut cell = Particle {
+                id,
+                center,
+                half: tile * 0.5,
+                position: Spring::default(),
+                spread: Spring::default(),
+                rotation: Spring::default(),
+                tilt: Spring::default(),
+                pin: Spring::default(),
+                pin_target: false,
+                radial: (0., 0.).into(),
+                delay: Duration::ZERO,
+                response_ms: 120.,
+            };
+            cell.configure(anchor, size, self.config, true);
+            cell.position.finish(if first_grid {
+                self.history[0].position
+            } else {
+                target_at(&self.history, self.sampled_at.saturating_sub(cell.delay))
+            });
+            if cell.pin_target {
+                cell.position.finish(self.target);
+            }
+            self.cells.insert(id, cell);
+        }
+        Ok(())
+    }
+    pub fn sample(
+        &mut self,
+        now: Duration,
+        size: Size<f64, Logical>,
+        rect: Rectangle<f64, Logical>,
+    ) -> Result<FragmentSample, &'static str> {
+        if self.failed {
+            return Err("fragment episode preparation previously failed");
+        }
+        self.ensure_grid(size, rect)?;
+        self.advance(now);
+        let (e, _) = self.envelope(now);
+        let mut cells = Vec::new();
+        cells
+            .try_reserve(self.cells.len())
+            .map_err(|_| "fragment allocation failed")?;
+        for cell in self.cells.values() {
+            let pin = cell.pin.value.x.clamp(0., 1.);
+            let translation = (limited(
+                cell.position.value - self.target,
+                f64::from(self.config.max_lag),
+            ) + cell.spread.value)
+                .upscale((1. - pin) * e);
+            let angle = cell.rotation.value.x * (1. - pin) * e;
+            let tilt = cell.tilt.value.upscale((1. - pin) * e);
+            let speed = norm(cell.position.velocity + cell.spread.velocity)
+                + norm(cell.rotation.velocity) * cell.half;
+            cells.push(FragmentCell {
+                center: [cell.center.x as f32, cell.center.y as f32],
+                half_extent: [cell.half as f32; 2],
+                translation: [translation.x as f32, translation.y as f32],
+                rotation: angle as f32,
+                tilt: [tilt.x as f32, tilt.y as f32],
+                edge_blend: (speed / 48.).clamp(0., 1.) as f32,
+                pin_weight: pin as f32,
+            });
+        }
+        Ok(FragmentSample {
+            cells: cells.into(),
+            max_lag: f64::from(self.config.max_lag),
+        })
+    }
+}
