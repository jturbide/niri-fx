+fn fragment_motion_renderer_reload_defers_verdict_and_retires_failed_episode() {
+    use crate::render_helpers::RenderTarget;
+    let mut layout = fragment_input_layout();
+    fragment_input_tile(&layout).record_fragment_renderer(RenderTarget::Output, true);
+    let (output, pointer) = fragment_input_pointer(&layout);
+    assert!(layout.fragment_move_press(&1, &output, pointer));
+    let original = fragment_input_tile(&layout)
+        .fragment_motion
+        .borrow()
+        .clone()
+        .unwrap();
+    fragment_input_tile(&layout).record_fragment_renderer(RenderTarget::ScreenCapture, false);
+    assert!(fragment_input_tile(&layout).fragment_motion_enabled());
+    assert!(fragment_input_tile(&layout)
+        .fragment_motion
+        .borrow()
+        .is_some());
+
+    let mut config = niri_config::Config::default();
+    config.animations.window_movement.custom_shader = Some(format!(
+        "{}\n// nirifx-fragment-grid: 800 28\n// new selected source",
+        crate::animation::fragment_motion::MARKER
+    ));
+    layout.update_config(&config);
+    assert!(!fragment_input_tile(&layout).fragment_motion_enabled());
+    Op::AdvanceAnimations { msec_delta: 5 }.apply(&mut layout);
+    assert!(std::rc::Rc::ptr_eq(
+        fragment_input_tile(&layout)
+            .fragment_motion
+            .borrow()
+            .as_ref()
+            .unwrap(),
+        &original
+    ));
+    fragment_input_tile(&layout).record_fragment_renderer(RenderTarget::Output, true);
+    assert!(fragment_input_tile(&layout).fragment_motion_enabled());
+    layout.update_shaders();
+    assert!(!fragment_input_tile(&layout).fragment_motion_enabled());
+    assert!(fragment_input_tile(&layout)
+        .fragment_motion
+        .borrow()
+        .is_some());
+    fragment_input_tile(&layout).record_fragment_renderer(RenderTarget::Output, false);
+    assert!(fragment_input_tile(&layout)
+        .fragment_motion
+        .borrow()
+        .is_none());
+    fragment_input_tile(&layout).record_fragment_renderer(RenderTarget::Screencast, true);
+    assert!(!layout.fragment_move_press(&1, &output, pointer));
+
+    fragment_input_tile(&layout).record_fragment_renderer(RenderTarget::Output, true);
+    assert!(layout.fragment_move_press(&1, &output, pointer));
+    config.animations.window_movement.anim.off = true;
+    layout.update_config(&config);
+    assert!(!fragment_input_tile(&layout).fragment_motion_enabled());
+    assert!(fragment_input_tile(&layout)
+        .fragment_motion
+        .borrow()
+        .is_none());
+}
