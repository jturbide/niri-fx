+    #[test]
+    fn marker_and_grid_are_strict_and_failed_reload_does_not_verify() {
+        let good = "// nirifx-fragment-motion: 3\n// nirifx-fragment-grid: 800 28\n";
+        assert!(supported(good));
+        assert!(!supported(MARKER));
+        for value in [
+            "800 nan",
+            "-1 28",
+            "4097 28",
+            "800.5 28",
+            "800 7",
+            "800 129",
+            "800 28 extra",
+        ] {
+            assert!(
+                !supported(&format!("{MARKER}\n{GRID_MARKER}{value}")),
+                "{value}"
+            );
+        }
+        assert!(selected(Some(good), Some(good)));
+        assert!(!selected(Some(good), Some(&format!("{good}different"))));
+    }
+    #[test]
+    fn delayed_target_holds_far_world_positions_then_independently_catches_up() {
+        let mut state = prepared();
+        state.push((40., 0.).into(), at(0));
+        let onset = sample(&mut state, 0);
+        for cell in onset.cells.iter().filter(|cell| cell.pin_weight == 0.) {
+            assert!((cell.translation[0] + 40.).abs() < 1e-6);
+        }
+        let early = sample(&mut state, 100);
+        let mut delays = std::collections::BTreeSet::new();
+        for (particle, cell) in state.cells.values().zip(early.cells.iter()) {
+            if particle.center.y > 390. {
+                assert!(particle.delay > at(100));
+                assert!((40. + cell.translation[0]).abs() < 0.001);
+                delays.insert(particle.delay.as_millis());
+            }
+        }
+        assert!(delays.len() > 16, "far pieces must not share a sheet");
+        let later = sample(&mut state, 600);
+        let histories: std::collections::BTreeSet<_> = later
+            .cells
+            .iter()
+            .filter(|c| c.center[1] > 390.)
+            .map(|c| (c.translation[0] * 1000.) as i32)
+            .collect();
+        assert!(histories.len() > 16);
+        let rest = sample(&mut state, 2200);
+        assert!(rest
+            .cells
+            .iter()
+            .all(|cell| cell.translation[0].abs() < 0.01));
+    }
+    #[test]
+    fn queued_reversal_keeps_world_pose_velocity_and_delayed_forward_motion() {
