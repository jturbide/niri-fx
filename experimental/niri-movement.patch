+#[test]
+fn early_return_spatial_press_has_owned_cleanup_without_a_seat_press() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    f.niri().layout.open_overview();
+    f.niri_complete_animations();
+    pa.motion_absolute(1, 640, 400, 1280, 800);
+    pa.frame();
+    f.roundtrip(a);
+    button(&mut f, a, &pa, RIGHT, ButtonState::Pressed);
+    assert!(seat
+        .with_grab(|_, grab| grab.as_any().is::<SpatialMovementGrab>())
+        .unwrap_or(false));
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(!seat.is_grabbed());
+    f.niri().layout.close_overview();
+    let (b, pb) = virtual_pointer(&mut f);
+    button(&mut f, b, &pb, LEFT, ButtonState::Pressed);
+    button(&mut f, b, &pb, LEFT, ButtonState::Released);
+    assert!(
+        !seat.is_grabbed(),
+        "removed spatial press left stale seat state"
+    );
+}
