+    resize_source_set_size(layout, 1, vertical, extent);
+}
+
+fn resize_source_set_size(layout: &mut Layout<TestWindow>, id: usize, vertical: bool, extent: i32) {
+    let mut size = layout
+        .active_workspace()
+        .unwrap()
+        .tiles()
+        .find(|tile| *tile.window().id() == id)
+        .unwrap()
+        .window()
+        .size();
+    if vertical {
+        size.h = extent;
+    } else {
+        size.w = extent;
+    }
+    let change = SizeChange::SetFixed(extent);
+    let request = if vertical {
+        Op::SetWindowHeight {
+            id: Some(id),
+            change,
+        }
+    } else {
+        Op::SetWindowWidth {
+            id: Some(id),
+            change,
+        }
+    };
+    check_ops_on_layout(
+        layout,
+        [
+            request,
+            Op::SetForcedSize {
+                id,
+                size: Some(size),
+            },
+            Op::Communicate(id),
+            Op::Communicate(2),
+        ],
+    );
+}
