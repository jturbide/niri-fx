+
+impl ResizeMaterial {
+    pub fn reference(&self) -> ResizeReference {
+        ResizeReference {
+            phase: self.phase.clone(),
+            reference_size: self.reference_size,
+            reference_from_size: self.reference_from_size,
+            reference_to_size: self.reference_to_size,
+        }
+    }
+
+    pub fn new(phase: Animation, from: Size<f64, Logical>, to: Size<f64, Logical>) -> Self {
+        Self {
+            phase,
+            reference_size: to,
+            reference_from_size: from,
+            reference_to_size: to,
+            content_size: to,
+            targets: RefCell::new(std::array::from_fn(|_| TargetMaterial::default())),
+            program: RefCell::new(None),
+            context: RefCell::new(None),
+            ignore_snapshot: Cell::new(false),
