index 0000000000000000000000000000000000000000..f27f87ecf3f1c949ef1d503b068389b1cb07016b
--- /dev/null
+++ b/src/animation/movement.rs
@@ -0,0 +1,477 @@
+//! Position continuity for the optional movement-shader experiment.
+//!
+//! Layout still owns the destination. Only an interrupted, opted-in movement
+//! uses a Hermite segment: its incoming position and velocity are preserved,
+//! and it reaches the new destination at rest on the original animation clock.
+
+use std::time::Duration;
+
+use super::{Animation, ResizePath};
+
+#[derive(Debug, Clone)]
+pub(crate) struct MoveAnimation {
+    pub anim: Animation,
+    pub from: f64,
+    handoff: Option<Handoff>,
+    minimum: Option<f64>,
+    resize: Vec<(ResizePath, f64)>,
+    folded: Vec<ResizePath>,
+    corrections: Vec<MoveAnimation>,
+}
+
+#[derive(Debug, Clone)]
+struct Handoff {
+    position: f64,
+    velocity: f64,
+    start: Duration,
+    end: Duration,
+    brake: Option<(f64, f64)>,
+}
+
+impl Handoff {
+    fn sample(&self, at: Duration) -> (f64, f64) {
+        let seconds = self.end.saturating_sub(self.start).as_secs_f64();
+        if seconds <= 0. || at >= self.end {
+            return (0., 0.);
+        }
+        let elapsed = at.saturating_sub(self.start).as_secs_f64();
+        if let Some((brake_time, stopped)) = self.brake {
+            if elapsed < brake_time {
+                let acceleration = -self.velocity / brake_time;
+                return (
+                    self.position + self.velocity * elapsed + acceleration * elapsed * elapsed / 2.,
+                    self.velocity + acceleration * elapsed,
+                );
+            }
+            let duration = seconds - brake_time;
+            let t = (elapsed - brake_time) / duration;
+            return (
+                stopped * (2. * t * t * t - 3. * t * t + 1.),
+                stopped * (6. * t * t - 6. * t) / duration,
+            );
+        }
+        let t = elapsed / seconds;
+        let t2 = t * t;
+        let t3 = t2 * t;
+        let slope = self.velocity * seconds;
+        (
+            self.position * (2. * t3 - 3. * t2 + 1.) + slope * (t3 - 2. * t2 + t),
+            (self.position * (6. * t2 - 6. * t) + slope * (3. * t2 - 4. * t + 1.)) / seconds,
+        )
+    }
+}
+
+impl MoveAnimation {
+    /// `velocity` is in logical pixels per compositor-clock second, already
+    /// adjusted for slow motion. Do not apply the clock rate a second time.
+    pub fn new(anim: Animation, from: f64, velocity: Option<f64>) -> Self {
+        let handoff = velocity
+            .filter(|_| !anim.is_done())
+            .map(|velocity| Handoff {
+                position: from,
+                velocity,
+                start: anim.start_time(),
+                end: anim.end_time(),
+                brake: None,
+            });
+        Self {
+            anim,
+            from,
+            handoff,
+            minimum: None,
+            resize: Vec::new(),
+            folded: Vec::new(),
+            corrections: Vec::new(),
+        }
+    }
+
+    /// Constrain only a source resize path, never the sum of layout movements.
+    pub fn with_minimum(mut self, minimum: f64) -> Self {
+        self.minimum = Some(minimum);
+        if let Some(handoff) = &mut self.handoff {
+            let duration = handoff.end.saturating_sub(handoff.start).as_secs_f64();
+            // The cubic's extrema identify whether incoming momentum would cross
+            // the floor. If it does, brake to rest before the floor, then finish
+            // with a zero-tangent cubic. Position and speed agree at both joins.
+            let p = handoff.position;
+            let v = handoff.velocity * duration;
+            let a = 6. * p + 3. * v;
+            let b = -6. * p - 4. * v;
+            let c = v;
+            let mut low = p.min(0.);
+            let mut check = |t: f64| {
+                if 0. < t && t < 1. {
+                    low = low.min(
+                        p * (2. * t.powi(3) - 3. * t * t + 1.) + v * (t.powi(3) - 2. * t * t + t),
+                    );
+                }
+            };
+            if a.abs() < 1e-12 {
+                if b.abs() >= 1e-12 {
+                    check(-c / b);
+                }
+            } else {
+                let discriminant = b * b - 4. * a * c;
+                if discriminant >= 0. {
+                    check((-b - discriminant.sqrt()) / (2. * a));
+                    check((-b + discriminant.sqrt()) / (2. * a));
+                }
+            }
+            if low < minimum && handoff.velocity < 0. && duration > 0. {
+                let distance = (p - minimum).max(0.);
+                let braking = (2. * distance / -handoff.velocity).min(duration / 2.);
+                if braking > 1e-9 {
+                    let stopped = (p + handoff.velocity * braking / 2.).max(minimum);
+                    handoff.brake = Some((braking, stopped));
+                } else {
+                    // A negative tangent at the floor is physically infeasible.
+                    // Keep position and discard only the outward velocity.
+                    handoff.velocity = 0.;
+                }
+            }
+        }
+        self
+    }
+
+    pub fn has_resize(&self) -> bool {
+        !self.resize.is_empty() || !self.folded.is_empty() || !self.corrections.is_empty()
+    }
+
+    pub fn is_done(&self) -> bool {
+        self.anim.is_done()
+            && self.resize.iter().all(|(path, _)| path.is_done())
+            && self.folded.iter().all(ResizePath::is_done)
+            && self.corrections.iter().all(Self::is_done)
+    }
+
+    /// Attach once per source axis. Retargets update the shared path in place;
+    /// another source and any unrelated movement keep their own clocks.
+    pub fn with_folded_sources(mut self, previous: Option<&Self>) -> Self {
+        if let Some(previous) = previous {
+            for path in previous
+                .resize
+                .iter()
+                .map(|(path, _)| path)
+                .chain(previous.folded.iter())
+            {
+                if !path.is_done()
+                    && !self
+                        .folded
+                        .iter()
+                        .any(|existing| existing.same_source(path))
+                {
+                    self.folded.push(path.clone());
+                }
+            }
+        }
+        self
+    }
+
+    pub fn follow_resize(
+        slot: &mut Option<Self>,
+        path: ResizePath,
+        factor: f64,
+        source_delta: f64,
+    ) {
+        let old_factor = slot
+            .as_ref()
+            .and_then(|movement| {
+                movement
+                    .resize
+                    .iter()
+                    .find(|(existing, _)| existing.same_source(&path))
+                    .map(|(_, factor)| *factor)
+            })
+            .unwrap_or(0.);
+        if factor == 0. && old_factor == 0. {
+            return;
+        }
+        let movement = slot.get_or_insert_with(|| Self::new(path.animation(), 0., None));
+        let folded = movement
+            .folded
+            .iter()
+            .any(|existing| existing.same_source(&path));
+        let correction = (old_factor - factor) * (path.offset() - source_delta);
+        if old_factor != factor && (old_factor != 0. || folded || correction.abs() > 1e-8) {
+            // A shared correction clock matters when focus changes the anchor
+            // side: flattening the same correction into columns with different
+            // movement deadlines would make their spacing diverge later.
+            let velocity = (old_factor - factor) * path.velocity();
+            let anim = path.animation();
+            let now = anim.clock.now();
+            let mut correction = Self::new(anim, correction, Some(velocity));
+            if let Some(handoff) = &mut correction.handoff {
+                // An orthogonal client commit can reassign this source without
+                // retargeting its axis. Keep its deadline, but start the new
+                // correction at the sampled current state, never in the past.
+                handoff.start = now;
+            }
+            movement.corrections.push(correction);
+        }
+        movement
+            .corrections
+            .retain(|correction| !correction.is_done());
+        movement
+            .resize
+            .retain(|(existing, _)| !existing.same_source(&path) && !existing.is_done());
+        movement
+            .folded
+            .retain(|existing| !existing.same_source(&path) && !existing.is_done());
+        if factor != 0. {
+            movement.resize.push((path, factor));
+        } else {
+            movement.folded.push(path);
+        }
+    }
+
+    /// Shader phase follows an active constituent; geometric sampling below
+    /// always sums each independent path, including ones with later deadlines.
+    pub fn render_animation(&self) -> Animation {
+        self.resize
+            .iter()
+            .filter(|(path, _)| !path.is_done())
+            .map(|(path, _)| path.animation())
+            .chain(
+                self.corrections
+                    .iter()
+                    .filter(|correction| !correction.is_done())
+                    .map(Self::render_animation),
+            )
+            .chain((!self.anim.is_done()).then(|| self.anim.clone()))
+            .max_by_key(Animation::start_time)
+            .unwrap_or_else(|| self.anim.clone())
+    }
+
+    pub fn distance(&self) -> f64 {
+        self.from
+            + self
+                .resize
+                .iter()
+                .map(|(path, factor)| path.distance() * factor)
+                .sum::<f64>()
+            + self.corrections.iter().map(Self::distance).sum::<f64>()
+    }
+
+    pub fn offset(&self) -> f64 {
+        let raw = self.own_offset();
+        let own = self.minimum.map_or(raw, |minimum| raw.max(minimum));
+        own + self
+            .resize
+            .iter()
+            .map(|(path, factor)| path.offset() * factor)
+            .sum::<f64>()
+            + self.corrections.iter().map(Self::offset).sum::<f64>()
+    }
+
+    fn own_offset(&self) -> f64 {
+        if let Some(handoff) = &self.handoff {
+            if self.anim.is_done() {
+                return 0.;
+            }
+            handoff.sample(self.anim.clock.now()).0
+        } else {
+            // Keep upstream behavior, including animations-off event-loop
+            // semantics, for initial moves and moves without a custom shader.
+            self.from * self.anim.value()
+        }
+    }
+
+    pub fn velocity(&self) -> f64 {
+        let own = if self
+            .minimum
+            .is_some_and(|minimum| self.own_offset() < minimum)
+        {
+            0.
+        } else {
+            self.own_velocity()
+        };
+        own + self
+            .resize
+            .iter()
+            .map(|(path, factor)| path.velocity() * factor)
+            .sum::<f64>()
+            + self.corrections.iter().map(Self::velocity).sum::<f64>()
+    }
+
+    fn own_velocity(&self) -> f64 {
+        if self.anim.is_done() {
+            return 0.;
+        }
+        let at = self.anim.clock.now();
+        if let Some(handoff) = &self.handoff {
+            return handoff.sample(at).1;
+        }
+        // Sample upstream easing/spring equations instead of duplicating them.
+        // Use the unclamped value: a spring can cross its target before resting.
+        let step = Duration::from_micros(100);
+        let before = at.saturating_sub(step).max(self.anim.start_time());
+        let after = (at + step).min(self.anim.end_time());
+        if after <= before {
+            return 0.;
+        }
+        self.from * (self.anim.value_at(after) - self.anim.value_at(before))
+            / (after - before).as_secs_f64()
+    }
+
+    /// Adjust an ongoing layout offset without discarding its momentum or
+    /// extending its deadline. Upstream's tiny-tail behavior remains unchanged
+    /// for the ordinary animation path.
+    pub fn offset_current(&mut self, offset: f64) {
+        if self.handoff.is_some() && !self.anim.is_done() {
+            self.handoff = Some(Handoff {
+                position: self.own_offset() + offset,
+                velocity: self.own_velocity(),
+                start: self.anim.clock.now(),
+                end: self.anim.end_time(),
+                brake: None,
+            });
+        }
+        let value = self.anim.value();
+        if value > 0.001 {
+            self.from += offset / value;
+        }
+    }
+}
+
