+//! Experimental movement shader path. The regular renderer is the fallback.
+use super::offscreen::{OffscreenBuffer, OffscreenData};
+use super::shader_element::ShaderRenderElement;
+use super::shaders::{mat3_uniform, ProgramType};
+use anyhow::Context as _;
+use glam::{Mat3, Vec2};
+use smithay::backend::renderer::element::{Element, Kind, RenderElement};
+use smithay::backend::renderer::gles::{GlesRenderer, Uniform};
+use smithay::backend::renderer::Texture;
+use smithay::utils::{Logical, Point, Rectangle, Scale, Size};
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+use std::time::Duration;
+
+use crate::animation::{Animation, Clock};
+
+/// Layout samples use the compositor clock, so slow-motion and repeated render
+/// passes cannot change the effect's trajectory. Velocity is in logical units/s.
+#[derive(Debug, Clone, Copy)]
+pub struct MovementState {
+    pub progress: f64,
+    pub delta: Point<f64, Logical>,
+    at: Duration,
+    end: Duration,
+    velocity: f64,
+    travel_velocity: Point<f64, Logical>,
+    remaining: Point<f64, Logical>,
+}
+
+impl MovementState {
+    pub fn from_animation(animation: &Animation, delta: Point<f64, Logical>, at: Duration) -> Self {
+        let progress = 1. - animation.clamped_value().clamp(0., 1.);
+        // Sampling the existing curve avoids duplicating Niri's easing and
+        // spring equations. Clamp both samples just like the rendered phase.
+        let step = Duration::from_micros(100);
+        let before = at.saturating_sub(step).max(animation.start_time());
+        let after = (at + step).min(animation.end_time());
+        let velocity = if after > before && progress < 1. {
+            (animation.value_at(before).clamp(0., 1.) - animation.value_at(after).clamp(0., 1.))
+                / (after - before).as_secs_f64()
+        } else {
+            0.
+        };
+        Self {
+            progress,
+            delta,
+            at,
+            end: animation.end_time(),
+            velocity,
+            travel_velocity: delta.upscale(velocity),
+            remaining: delta.upscale(1. - progress),
+        }
+    }
+
+    /// Position handoffs are independent of shader phase. Closing must follow
+    /// the actual layout path, including momentum through a direction change.
+    pub fn with_layout(
+        mut self,
+        remaining: Point<f64, Logical>,
+        velocity: Point<f64, Logical>,
+    ) -> Self {
+        self.remaining = remaining;
+        self.travel_velocity = velocity;
+        self
+    }
+
+    pub fn combined(self, other: Self) -> Self {
+        let driver = if self.progress <= other.progress {
+            self
+        } else {
+            other
+        };
+        Self {
+            delta: self.delta + other.delta,
+            travel_velocity: self.travel_velocity + other.travel_velocity,
+            remaining: self.remaining + other.remaining,
+            end: self.end.max(other.end),
+            ..driver
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct Sample {
+    value: f64,
+    velocity: f64,
+}
+
+/// A cubic finishes with zero speed and retains its incoming derivative. Phase
+/// curves shorten their duration when needed to stay monotone in [0, 1]. The
+/// signed impulse may briefly overshoot: clamping it would introduce a kink.
+#[derive(Debug, Clone, Copy)]
+struct Curve {
+    from: Sample,
+    target: f64,
+    start: Duration,
+    seconds: f64,
+}
+
+impl Curve {
+    fn new(from: Sample, target: f64, start: Duration, end: Duration) -> Self {
+        Self {
+            from,
+            target,
+            start,
+            seconds: end.saturating_sub(start).as_secs_f64(),
+        }
+    }
+
+    fn phase(from: Sample, start: Duration, end: Duration) -> Self {
+        let mut curve = Self::new(from, 1., start, end);
+        if from.velocity > 0. {
+            curve.seconds = curve
+                .seconds
+                .min(3. * (1. - from.value).max(0.) / from.velocity);
+        }
+        curve
+    }
+
+    fn sample(self, at: Duration) -> Sample {
+        let elapsed = at.saturating_sub(self.start).as_secs_f64();
+        if self.seconds <= 1e-9 || elapsed >= self.seconds {
+            return Sample {
+                value: self.target,
+                velocity: 0.,
+            };
+        }
+        let t = elapsed / self.seconds;
+        let t2 = t * t;
+        let t3 = t2 * t;
+        let slope = self.from.velocity * self.seconds;
+        Sample {
+            value: self.from.value * (2. * t3 - 3. * t2 + 1.)
+                + slope * (t3 - 2. * t2 + t)
+                + self.target * (-2. * t3 + 3. * t2),
+            velocity: (self.from.value * (6. * t2 - 6. * t)
+                + slope * (3. * t2 - 4. * t + 1.)
+                + self.target * (-6. * t2 + 6. * t))
+                / self.seconds,
+        }
+    }
+}
+
+/// Only shader deformation is retargeted here; Niri still owns layout position,
+/// hit testing and focus. Retargets carry both phase and direction derivatives.
+#[derive(Debug, Default)]
+struct MotionContinuity {
+    previous: Option<MovementState>,
+    phase: Sample,
+    impulse: [Sample; 2],
+    curves: Option<(Curve, [Curve; 2])>,
+}
+
+impl MotionContinuity {
+    fn values_at(&self, at: Duration) -> (Sample, [Sample; 2]) {
+        if let Some((phase, impulse)) = self.curves {
+            return (phase.sample(at), impulse.map(|curve| curve.sample(at)));
+        }
+        // Between layout samples, predict only the unsampled fraction of a
+        // frame. Render passes at the same clock value are exactly idempotent.
+        let elapsed = self
+            .previous
+            .map_or(0., |old| at.saturating_sub(old.at).as_secs_f64());
+        let value = (self.phase.value + self.phase.velocity * elapsed).clamp(0., 1.);
+        (
+            Sample {
+                value,
+                velocity: if value >= 1. { 0. } else { self.phase.velocity },
+            },
+            self.impulse,
+        )
+    }
+
+    fn sample(&mut self, motion: MovementState) -> (f64, [f32; 2]) {
+        let target = [
+            if motion.delta.x < 0. { -1. } else { 1. },
+            if motion.delta.y < 0. { -1. } else { 1. },
+        ];
+        if let Some(previous) = self.previous {
+            if motion.progress < previous.progress || motion.delta != previous.delta {
+                let (phase, impulse) = self.values_at(motion.at);
+                self.curves = Some((
+                    Curve::phase(phase, motion.at, motion.end),
+                    std::array::from_fn(|i| {
+                        Curve::new(impulse[i], target[i], motion.at, motion.end)
+                    }),
+                ));
+            }
+        } else {
+            self.impulse = target.map(|value| Sample {
+                value,
+                velocity: 0.,
+            });
+        }
+        if let Some((phase, impulse)) = self.curves {
+            self.phase = phase.sample(motion.at);
+            self.impulse = impulse.map(|curve| curve.sample(motion.at));
+        } else {
+            self.phase = Sample {
+                value: motion.progress,
+                velocity: motion.velocity.max(0.),
+            };
+        }
+        self.previous = Some(motion);
+        (
+            self.phase.value,
+            self.impulse.map(|value| value.value as f32),
+        )
+    }
+}
+
+/// Closing keeps the same phase/direction clocks. Its translation starts with
+/// the sampled layout velocity and eases to the remaining destination while
+/// ClosingWindow independently fades opacity on the configured close clock.
+#[derive(Debug)]
+pub struct MovementContinuation {
+    clock: Clock,
+    phase: Curve,
+    impulse: [Curve; 2],
+    travel: [Curve; 2],
+}
+
+impl MovementContinuation {
+    pub fn sample(&self) -> (f64, [f32; 2], Point<f64, Logical>) {
+        let at = self.clock.now();
+        (
+            self.phase.sample(at).value,
+            self.impulse.map(|curve| curve.sample(at).value as f32),
+            Point::from((
+                self.travel[0].sample(at).value,
+                self.travel[1].sample(at).value,
+            )),
+        )
+    }
+}
+
+#[derive(Debug)]
+pub struct MovementEffect {
+    random_seed: f32,
+    clock: Clock,
+    buffer: OffscreenBuffer,
+    continuity: RefCell<MotionContinuity>,
+}
+
+impl MovementEffect {
+    pub fn new(clock: Clock) -> Self {
+        Self {
+            random_seed: fastrand::f32(),
+            clock,
+            buffer: OffscreenBuffer::default(),
+            continuity: RefCell::new(MotionContinuity::default()),
+        }
+    }
+
+    pub fn continuation(&self) -> Option<crate::layout::closing_window::AnimationContinuation> {
+        let state = self.continuity.borrow();
+        let motion = state.previous?;
+        let at = self.clock.now();
+        let (phase, impulse) = state.values_at(at);
+        let remaining = motion.remaining;
+        let (phase, impulse) = state.curves.unwrap_or_else(|| {
+            (
+                Curve::phase(phase, at, motion.end),
+                impulse.map(|sample| Curve::new(sample, sample.value, at, motion.end)),
+            )
+        });
+        let travel = [
+            (remaining.x, motion.travel_velocity.x),
+            (remaining.y, motion.travel_velocity.y),
+        ]
+        .map(|(target, velocity)| {
+            Curve::new(
+                Sample {
+                    value: 0.,
+                    velocity,
+                },
+                target,
+                at,
+                motion.end,
+            )
+        });
+        Some(
+            crate::layout::closing_window::AnimationContinuation::Movement {
+                path: MovementContinuation {
+                    clock: self.clock.clone(),
+                    phase,
+                    impulse,
+                    travel,
+                },
+                random_seed: self.random_seed,
+                delta: motion.delta,
+            },
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn render(
+        &self,
+        renderer: &mut GlesRenderer,
+        elements: &[impl RenderElement<GlesRenderer>],
+        geo_size: Size<f64, Logical>,
+        location: Point<f64, Logical>,
+        scale: Scale<f64>,
+        alpha: f32,
+        motion: MovementState,
+    ) -> anyhow::Result<(ShaderRenderElement, OffscreenData)> {
+        let (progress, impulse) = self.continuity.borrow_mut().sample(motion);
+        let clamped_progress = progress.clamp(0., 1.);
+        let (elem, _sync_point, mut data) = self
+            .buffer
+            .render(renderer, scale, elements)
+            .context("error rendering movement to offscreen buffer")?;
+        // OffscreenBuffer renders with Transform::Normal and the scale that we passed, so we
+        // can assume that below.
+        let offset = elem.offset();
+        let texture = elem.texture();
+        let texture_size = elem.logical_size();
+
+        let mut area = Rectangle::new(location + offset, texture_size);
+
+        // Expand the area a bit to allow for more varied effects.
+        let mut target_size = area.size.upscale(1.5);
+        target_size.w = f64::max(area.size.w + 1000., target_size.w);
+        target_size.h = f64::max(area.size.h + 1000., target_size.h);
+        let diff = (target_size.to_point() - area.size.to_point()).downscale(2.);
+        let diff = diff.to_physical_precise_round(scale).to_logical(scale);
+        area.loc -= diff;
+        area.size += diff.upscale(2.).to_size();
+
+        let area_loc = Vec2::new(area.loc.x as f32, area.loc.y as f32);
+        let area_size = Vec2::new(area.size.w as f32, area.size.h as f32);
+
+        let geo_loc = Vec2::new(location.x as f32, location.y as f32);
+        let geo_size = Vec2::new(geo_size.w as f32, geo_size.h as f32);
+
+        let input_to_geo = Mat3::from_scale(area_size / geo_size)
+            * Mat3::from_translation((area_loc - geo_loc) / area_size);
+
+        let tex_scale = Vec2::new(scale.x as f32, scale.y as f32);
+        let tex_loc = Vec2::new(offset.x as f32, offset.y as f32);
+        let tex_size = Vec2::new(texture.width() as f32, texture.height() as f32) / tex_scale;
+
+        let geo_to_tex =
+            Mat3::from_translation(-tex_loc / tex_size) * Mat3::from_scale(geo_size / tex_size);
+
+        let elem = ShaderRenderElement::new(
+            ProgramType::Move,
+            area.size,
+            None,
+            scale.x as f32,
+            alpha,
+            Rc::new([
+                mat3_uniform("niri_input_to_geo", input_to_geo),
+                Uniform::new("niri_geo_size", geo_size.to_array()),
+                mat3_uniform("niri_geo_to_tex", geo_to_tex),
+                Uniform::new("niri_progress", progress as f32),
+                Uniform::new("niri_clamped_progress", clamped_progress as f32),
+                Uniform::new("niri_random_seed", self.random_seed),
+                Uniform::new("niri_move_impulse", impulse),
+                Uniform::new(
+                    "niri_move_delta",
+                    [motion.delta.x as f32, motion.delta.y as f32],
+                ),
+            ]),
+            HashMap::from([(String::from("niri_tex"), texture.clone())]),
+            Kind::Unspecified,
+        )
+        .with_location(area.loc);
+
+        // We're drawing the shader, not the offscreen itself.
+        data.id = elem.id().clone();
+
+        Ok((elem, data))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn state(progress: f64, x: f64, seconds: f64, end: f64) -> MovementState {
+        MovementState {
+            progress,
+            delta: Point::from((x, 0.)),
+            at: Duration::from_secs_f64(seconds),
+            end: Duration::from_secs_f64(end),
+            velocity: 1.,
+            travel_velocity: Point::from((x, 0.)),
+            remaining: Point::from((x * (1. - progress), 0.)),
+        }
+    }
+
+    #[test]
+    fn uninterrupted_phase_matches_layout() {
+        let mut motion = MotionContinuity::default();
+        for p in [0., 0.2, 0.5, 0.8, 1.] {
+            assert_eq!(motion.sample(state(p, 500., p, 1.)), (p, [1., 1.]));
+        }
+    }
+
+    #[test]
+    fn reversal_keeps_value_and_velocity_then_settles() {
+        let mut motion = MotionContinuity::default();
+        let before = motion.sample(state(0.4, 500., 0.4, 1.));
+        assert_eq!(motion.sample(state(0., -500., 0.4, 1.4)), before);
+        assert!((motion.phase.velocity - 1.).abs() < 1e-9);
+        motion.sample(state(0.2, -500., 0.6, 1.4));
+        let phase = motion.phase;
+        let impulse = motion.impulse;
+        let before = motion.sample(state(0., 500., 0.6, 1.6));
+        assert!((motion.phase.value - phase.value).abs() < 1e-9);
+        assert!((motion.phase.velocity - phase.velocity).abs() < 1e-9);
+        assert!((motion.impulse[0].velocity - impulse[0].velocity).abs() < 1e-9);
+        assert_eq!(motion.sample(state(0., 500., 0.6, 1.6)), before);
+        assert_eq!(motion.sample(state(1., 500., 1.6, 1.6)), (1., [1., 1.]));
+    }
+
+    #[test]
+    fn phase_stays_monotone_even_with_fast_late_handoffs() {
+        for value in [0., 0.4, 0.99, 1.] {
+            for velocity in [0., 0.1, 1., 10., 100.] {
+                let curve = Curve::phase(
+                    Sample { value, velocity },
+                    Duration::ZERO,
+                    Duration::from_secs(1),
+                );
+                let mut previous = value;
+                for frame in 0..=1000 {
+                    let sample = curve.sample(Duration::from_millis(frame));
+                    assert!(sample.value >= previous - 1e-12 && sample.value <= 1. + 1e-12);
+                    assert!(sample.velocity >= -1e-9);
+                    previous = sample.value;
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn finite_difference_confirms_incoming_derivative_and_zero_endpoint() {
+        let from = Sample {
+            value: 0.35,
+            velocity: 0.8,
+        };
+        let curve = Curve::phase(from, Duration::ZERO, Duration::from_secs(1));
+        let h = Duration::from_micros(1);
+        assert!(
+            ((curve.sample(h).value - from.value) / h.as_secs_f64() - from.velocity).abs() < 1e-5
+        );
+        let end = curve.sample(Duration::from_secs(1));
+        assert_eq!((end.value, end.velocity), (1., 0.));
+        let instant = Curve::phase(from, Duration::ZERO, Duration::ZERO).sample(Duration::ZERO);
+        assert_eq!((instant.value, instant.velocity), (1., 0.));
+    }
+
+    #[test]
+    fn close_path_keeps_clock_phase_impulse_and_translation_speed() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let effect = MovementEffect::new(clock.clone());
+        effect
+            .continuity
+            .borrow_mut()
+            .sample(state(0.4, 500., 0., 1.));
+        let crate::layout::closing_window::AnimationContinuation::Movement { path, .. } =
+            effect.continuation().unwrap()
+        else {
+            panic!("movement path");
+        };
+        assert_eq!(path.sample(), (0.4, [1., 1.], Point::from((0., 0.))));
+        clock.set_unadjusted(Duration::from_micros(1));
+        let (phase, _, travel) = path.sample();
+        assert!(((phase - 0.4) / 1e-6 - 1.).abs() < 1e-4);
+        assert!((travel.x / 1e-6 - 500.).abs() < 0.01);
+    }
+
+    #[test]
+    fn closing_after_retarget_uses_actual_layout_path() {
+        use crate::animation::{Curve as EasingCurve, MoveAnimation};
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let anim = Animation::ease(clock.clone(), 1., 0., 0., 1000, EasingCurve::EaseOutCubic);
+        // Destination is now to the left, but momentum still carries right.
+        let movement = MoveAnimation::new(anim, 200., Some(450.));
+        clock.set_unadjusted(Duration::from_millis(200));
+        let expected_remaining = -movement.offset();
+        let expected_velocity = movement.velocity();
+        let effect = MovementEffect::new(clock.clone());
+        let motion = MovementState::from_animation(
+            &movement.anim,
+            Point::from((-movement.from, 0.)),
+            clock.now(),
+        )
+        .with_layout(
+            Point::from((expected_remaining, 0.)),
+            Point::from((expected_velocity, 0.)),
+        );
+        assert!((motion.remaining.x - motion.delta.x * (1. - motion.progress)).abs() > 1.);
+        effect.continuity.borrow_mut().sample(motion);
+        let crate::layout::closing_window::AnimationContinuation::Movement { path, .. } =
+            effect.continuation().unwrap()
+        else {
+            panic!("movement path");
+        };
+        clock.set_unadjusted(Duration::from_micros(200_001));
+        assert!((path.sample().2.x / 1e-6 - expected_velocity).abs() < 0.01);
+        clock.set_unadjusted(Duration::from_secs(1));
+        assert!((path.sample().2.x - expected_remaining).abs() < 1e-9);
+    }
+
+    #[test]
+    fn combined_axes_keep_both_remaining_distances_and_velocities() {
+        let column =
+            state(0.3, 500., 0., 1.).with_layout(Point::from((250., 0.)), Point::from((450., 0.)));
+        let tile =
+            state(0.5, 0., 0., 1.).with_layout(Point::from((0., -80.)), Point::from((0., 75.)));
+        let combined = column.combined(tile);
+        assert_eq!(combined.remaining, Point::from((250., -80.)));
+        assert_eq!(combined.travel_velocity, Point::from((450., 75.)));
+    }
+}
