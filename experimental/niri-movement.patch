+//! Shared per-axis resize geometry and neighboring layout displacement.
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use smithay::utils::{Logical, Size};
+
+use super::{Animation, MoveAnimation};
+
+#[derive(Debug)]
+struct ResizeAxis {
+    target: f64,
+    movement: MoveAnimation,
+    maximum: Option<Vec<(Option<ResizePath>, f64)>>,
+    extra: f64,
+    finished: bool,
+}
+
+/// A source axis retains this identity through retargets. Neighboring layout
+/// movements hold only this path, so they cannot clamp or restart each other.
+#[derive(Debug, Clone)]
+pub(crate) struct ResizePath(Rc<RefCell<ResizeAxis>>);
+
+impl ResizePath {
+    fn new(anim: &Animation, from: f64, target: f64) -> Self {
+        Self(Rc::new(RefCell::new(ResizeAxis {
+            target,
+            movement: MoveAnimation::new(anim.restarted(1., 0., 0.), from - target, None)
+                .with_minimum(1. - target),
+            maximum: None,
+            extra: 0.,
+            finished: false,
+        })))
+    }
+
+    fn retarget(&self, anim: &Animation, from: f64, target: f64) {
+        let mut axis = self.0.borrow_mut();
+        if target == axis.target {
+            return;
+        }
+        let moving = !axis.movement.is_done()
+            && (axis.movement.offset() != 0. || axis.movement.velocity() != 0.);
+        let velocity = moving.then(|| axis.movement.velocity());
+        let clock = if moving { &axis.movement.anim } else { anim };
+        axis.movement = MoveAnimation::new(clock.restarted(1., 0., 0.), from - target, velocity)
+            .with_minimum(1. - target);
+        axis.target = target;
+    }
+
+    /// Column width is the maximum of its constituent tile widths. Share that
+    /// envelope rather than following whichever asynchronous client committed last.
+    pub fn update_maximum(
+        slot: &mut Option<Self>,
+        target: f64,
+        extra: f64,
+        members: Vec<(Option<Self>, f64)>,
+    ) {
+        let animation = members
+            .iter()
+            .filter_map(|(path, _)| path.as_ref())
+            .map(Self::animation)
+            .max_by_key(Animation::start_time);
+        if slot.is_none() {
+            let Some(anim) = animation else {
+                return;
+            };
+            *slot = Some(Self::new(&anim, target, target));
+        }
+        let mut axis = slot.as_ref().unwrap().0.borrow_mut();
+        axis.target = target;
+        axis.extra = extra;
+        axis.maximum = Some(members);
+    }
+
+    pub fn animation(&self) -> Animation {
+        let axis = self.0.borrow();
+        axis.maximum
+            .as_ref()
+            .and_then(|members| {
+                members
+                    .iter()
+                    .filter_map(|(path, _)| path.as_ref())
+                    .filter(|path| !path.is_done())
+                    .map(Self::animation)
+                    .max_by_key(Animation::start_time)
+            })
+            .unwrap_or_else(|| axis.movement.anim.clone())
+    }
+    /// Closing owns a detached trajectory: layout removal and future retargets
+    /// must not settle or alter a surface that is still fading out.
+    fn detached(&self) -> Self {
+        let axis = self.0.borrow();
+        Self(Rc::new(RefCell::new(ResizeAxis {
+            target: axis.target,
+            movement: axis.movement.clone(),
+            maximum: axis.maximum.as_ref().map(|members| {
+                members
+                    .iter()
+                    .map(|(path, size)| (path.as_ref().map(Self::detached), *size))
+                    .collect()
+            }),
+            extra: axis.extra,
+            finished: axis.finished,
+        })))
+    }
+
+    pub fn same_source(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.0, &other.0)
+    }
+    pub fn finish(&self) {
+        self.0.borrow_mut().finished = true;
+    }
+
+    pub fn is_done(&self) -> bool {
+        let axis = self.0.borrow();
+        if axis.finished {
+            return true;
+        }
+        axis.maximum.as_ref().map_or_else(
+            || axis.movement.is_done(),
+            |members| {
+                members
+                    .iter()
+                    .all(|(path, _)| path.as_ref().is_none_or(Self::is_done))
+            },
+        )
+    }
+    pub fn offset(&self) -> f64 {
+        let axis = self.0.borrow();
+        Self::value_of(&axis) - axis.target
+    }
+    pub fn velocity(&self) -> f64 {
+        let axis = self.0.borrow();
+        if axis.finished {
+            return 0.;
+        }
+        if let Some(members) = &axis.maximum {
+            Self::widest(members)
+                .and_then(|(path, _)| path.as_ref())
+                .map_or(0., Self::velocity)
+        } else {
+            axis.movement.velocity()
+        }
+    }
+    pub fn distance(&self) -> f64 {
+        let axis = self.0.borrow();
+        if axis.finished {
+            return 0.;
+        }
+        if let Some(members) = &axis.maximum {
+            Self::widest(members)
+                .and_then(|(path, _)| path.as_ref())
+                .map_or(0., Self::distance)
+        } else {
+            axis.movement.from
+        }
+    }
+    fn widest(members: &[(Option<Self>, f64)]) -> Option<&(Option<Self>, f64)> {
+        members.iter().max_by(|(a, size_a), (b, size_b)| {
+            a.as_ref()
+                .map_or(*size_a, Self::value)
+                .total_cmp(&b.as_ref().map_or(*size_b, Self::value))
+        })
+    }
+    fn value_of(axis: &ResizeAxis) -> f64 {
+        if axis.finished {
+            return axis.target;
+        }
+        if let Some(members) = &axis.maximum {
+            Self::widest(members)
+                .map_or(1., |(path, size)| path.as_ref().map_or(*size, Self::value))
+                + axis.extra
+        } else {
+            (axis.target + axis.movement.offset()).max(1.)
+        }
+    }
+    fn value(&self) -> f64 {
+        Self::value_of(&self.0.borrow())
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct SizeAnimation {
+    pub width: ResizePath,
+    pub height: ResizePath,
+}
+
+impl SizeAnimation {
+    pub fn new(
+        anim: &Animation,
+        from: Size<f64, Logical>,
+        target: Size<f64, Logical>,
+        previous: Option<Self>,
+    ) -> Self {
+        if let Some(previous) = previous {
+            previous.width.retarget(anim, from.w, target.w);
+            previous.height.retarget(anim, from.h, target.h);
+            previous
+        } else {
+            Self {
+                width: ResizePath::new(anim, from.w, target.w),
+                height: ResizePath::new(anim, from.h, target.h),
+            }
+        }
+    }
+
+    pub fn detached(&self) -> Self {
+        Self {
+            width: self.width.detached(),
+            height: self.height.detached(),
+        }
+    }
+
+    pub fn value(&self) -> Size<f64, Logical> {
+        Size::new(self.width.value(), self.height.value())
+    }
+
+    /// Explicit Off settles every consumer before the source drops its state.
+    pub fn finish(&self) {
+        self.width.finish();
+        self.height.finish();
+    }
+
+    pub fn is_done(&self) -> bool {
+        self.width.is_done() && self.height.is_done()
+    }
+
+    pub fn update_target(&mut self, target: Size<f64, Logical>, anim: &Animation) {
+        self.width.retarget(anim, self.width.value(), target.w);
+        self.height.retarget(anim, self.height.value(), target.h);
+    }
+}
