+#[test]
+fn explicit_owner_removal_ends_spatial_grab_without_releasing_other_button() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let (b, pb) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    let serial = seat.with_grab(|serial, _| serial).unwrap();
+    let start = seat.grab_start_data().unwrap();
+    let output = f.niri_output(1);
+    let ws = f.niri().layout.active_workspace().unwrap().id();
+    let grab = SpatialMovementGrab::new(start, output, ws, false);
+    seat.set_grab(f.niri_state(), grab, serial, Focus::Clear);
+    button(&mut f, b, &pb, RIGHT, ButtonState::Pressed);
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(!seat.has_grab(serial));
+    // B is still held. A fresh left press must not end its implicit grab until
+    // B's right release, proving removal did not reset the seat globally.
+    let (c, pc) = virtual_pointer(&mut f);
+    button(&mut f, c, &pc, LEFT, ButtonState::Pressed);
+    button(&mut f, c, &pc, LEFT, ButtonState::Released);
+    assert!(seat.is_grabbed());
+    button(&mut f, b, &pb, RIGHT, ButtonState::Released);
+    assert!(!seat.is_grabbed());
+}
