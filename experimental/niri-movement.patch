+#[test]
+fn disconnect_ends_pointer_screenshot_drag_but_preserves_touch_selection() {
+    use std::collections::HashMap;
+
+    use smithay::backend::input::TouchSlot;
+
+    use crate::animation::Animation;
+    use crate::ui::screenshot_ui::{Button, ScreenshotUi};
+
+    for touch_slot in [None, Some(TouchSlot::from(Some(1)))] {
+        let mut f = Fixture::new();
+        f.add_output(1, (1280, 800));
+        let (a, pa) = virtual_pointer(&mut f);
+        button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+        let output = f.niri_output(1);
+        let clock = f.niri().clock.clone();
+        let config = f.niri().config.clone();
+        let open_anim = Animation::new(
+            clock.clone(),
+            0.,
+            1.,
+            0.,
+            config.borrow().animations.screenshot_ui_open.0,
+        );
+        // Input-only fixture: no screenshot textures or file path are needed to
+        // prove the selection's modal state and touch ownership survive cleanup.
+        f.niri().screenshot_ui = ScreenshotUi::Open {
+            selection: (output.clone(), (10, 10).into(), (100, 100).into()),
+            output_data: HashMap::new(),
+            button: Button::Down {
+                touch_slot,
+                on_capture_button: false,
+                last_pos: (output, (100, 100).into()),
+                move_state: None,
+            },
+            show_pointer: false,
+            open_anim,
+            clock,
+            config,
+            path: None,
+        };
+        pa.destroy();
+        f.roundtrip(a);
+        let ScreenshotUi::Open { button, .. } = &f.niri().screenshot_ui else {
+            panic!("disconnect confirmed or closed the screenshot UI");
+        };
+        assert_eq!(matches!(button, Button::Down { .. }), touch_slot.is_some());
+    }
+}
