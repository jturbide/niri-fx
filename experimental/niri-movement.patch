+// Flat premultiplied content only: deformation is applied once afterward.
+vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
+    vec2 prev = (niri_geo_to_tex_prev * coords_curr_geo).xy;
+    vec2 next = (niri_geo_to_tex_next * coords_curr_geo).xy;
+    vec4 a = vec4(0.0), b = vec4(0.0);
+    if (all(greaterThanEqual(prev, vec2(0.0))) && all(lessThan(prev, vec2(1.0))))
+        a = texture2D(niri_tex_prev, prev);
+    if (all(greaterThanEqual(next, vec2(0.0))) && all(lessThan(next, vec2(1.0))))
+        b = texture2D(niri_tex_next, next);
+    return mix(a, b, smoothstep(0.2, 0.8, niri_clamped_progress));
+}
