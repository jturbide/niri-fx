+fn resize_handoff_reversal(vertical: bool) {
+    let mut layout = resize_handoff_layout(vertical, true);
+    resize_handoff_set_size(&mut layout, vertical, 200);
+    Op::AdvanceAnimations { msec_delta: 500 }.apply(&mut layout);
+    resize_handoff_assert_neighbors(&layout, vertical);
+    resize_handoff_set_size(&mut layout, vertical, 100);
+    resize_handoff_assert_neighbors(&layout, vertical);
+    for _ in 0..10 {
+        Op::AdvanceAnimations { msec_delta: 100 }.apply(&mut layout);
+        resize_handoff_assert_neighbors(&layout, vertical);
+    }
+}
