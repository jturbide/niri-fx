+++ b/src/input/pointer_buttons.rs
@@ -0,0 +1,202 @@
+use std::collections::{HashMap, HashSet};
+use std::hash::Hash;
+
+use smithay::utils::Serial;
+
+/// A seat press may have several device owners, but Smithay receives one press
+/// and one final release. None identifies a consumed bind/picker press.
+#[derive(Debug)]
+pub struct PointerButtons<D> {
+    presses: HashMap<(D, u32), Option<Serial>>,
+    sent: HashSet<u32>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct ReleasedButton {
+    pub button: u32,
+    pub serial: Serial,
+    pub sent: bool,
+}
+
+impl<D> Default for PointerButtons<D> {
+    fn default() -> Self {
+        Self {
+            presses: HashMap::new(),
+            sent: HashSet::new(),
+        }
+    }
+}
+
+impl<D: Clone + Eq + Hash> PointerButtons<D> {
+    /// Reserve a physical press before evaluating compositor bindings. Duplicate
+    /// presses do not retrigger actions. A consumed press stays device-local.
+    pub fn press(&mut self, device: D, button: u32) -> bool {
+        if self.presses.contains_key(&(device.clone(), button)) {
+            return false;
+        }
+        self.presses.insert((device, button), None);
+        true
+    }
+
+    /// Join the current seat press or start one with this serial. Keeping the
+    /// original serial ties client-requested and compositor grabs to the same
+    /// live owner set, even after the first device releases or disappears.
+    pub fn forward(&mut self, device: &D, button: u32, serial: Serial) -> bool {
+        let existing = self
+            .presses
+            .iter()
+            .find_map(|((_, code), serial)| (*code == button).then_some(*serial).flatten());
+        *self.presses.get_mut(&(device.clone(), button)).unwrap() =
+            Some(existing.unwrap_or(serial));
+        existing.is_none()
+    }
+
+    pub fn sent(&mut self, button: u32) {
+        self.sent.insert(button);
+    }
+
+    pub fn release(&mut self, device: &D, button: u32) -> Option<ReleasedButton> {
+        let serial = self.presses.remove(&(device.clone(), button))??;
+        if self
+            .presses
+            .iter()
+            .any(|((_, code), press)| *code == button && press.is_some())
+        {
+            return None;
+        }
+        Some(ReleasedButton {
+            button,
+            serial,
+            sent: self.sent.remove(&button),
+        })
+    }
+
+    pub fn remove_device(&mut self, device: &D) -> Vec<ReleasedButton> {
+        let mut buttons: Vec<_> = self
+            .presses
+            .keys()
+            .filter_map(|(owner, code)| (owner == device).then_some(*code))
+            .collect();
+        buttons.sort_unstable();
+        buttons
+            .into_iter()
+            .filter_map(|button| self.release(device, button))
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const LEFT: u32 = 0x110;
+    const RIGHT: u32 = 0x111;
+
+    fn forwarded(ledger: &mut PointerButtons<u64>, device: u64, button: u32, serial: u32) {
+        assert!(ledger.press(device, button));
+        if ledger.forward(&device, button, Serial::from(serial)) {
+            ledger.sent(button);
+        }
+    }
+
+    #[test]
+    fn overlapping_same_button_has_one_press_and_one_final_release() {
+        let mut ledger = PointerButtons::default();
+        forwarded(&mut ledger, 1, LEFT, 10);
+        assert!(ledger.press(2, LEFT));
+        assert!(!ledger.forward(&2, LEFT, Serial::from(20)));
+        assert_eq!(ledger.release(&1, LEFT), None);
+        assert!(ledger.remove_device(&1).is_empty());
+        assert_eq!(
+            ledger.release(&2, LEFT),
+            Some(ReleasedButton {
+                button: LEFT,
+                serial: 10.into(),
+                sent: true
+            })
+        );
+        assert_eq!(ledger.release(&2, LEFT), None);
+    }
+
+    #[test]
+    fn removal_releases_only_buttons_without_surviving_owners() {
+        let mut ledger = PointerButtons::default();
+        forwarded(&mut ledger, 1, LEFT, 10);
+        forwarded(&mut ledger, 1, RIGHT, 11);
+        forwarded(&mut ledger, 2, RIGHT, 20);
+        assert!(ledger.remove_device(&3).is_empty());
+        assert_eq!(
+            ledger.remove_device(&1),
+            vec![ReleasedButton {
+                button: LEFT,
+                serial: 10.into(),
+                sent: true
+            }]
+        );
+        assert_eq!(
+            ledger.release(&2, RIGHT),
+            Some(ReleasedButton {
+                button: RIGHT,
+                serial: 11.into(),
+                sent: true
+            })
+        );
+    }
+
+    #[test]
+    fn suppressed_bind_is_not_an_owner_of_another_devices_press() {
+        let mut ledger = PointerButtons::default();
+        assert!(ledger.press(1, LEFT));
+        forwarded(&mut ledger, 2, LEFT, 20);
+        assert!(!ledger.press(1, LEFT));
+        assert_eq!(ledger.release(&1, LEFT), None);
+        assert_eq!(
+            ledger.release(&2, LEFT),
+            Some(ReleasedButton {
+                button: LEFT,
+                serial: 20.into(),
+                sent: true
+            })
+        );
+        assert!(ledger.press(1, LEFT));
+        assert!(ledger.remove_device(&1).is_empty());
+        forwarded(&mut ledger, 1, LEFT, 30);
+        assert_eq!(ledger.release(&1, LEFT).unwrap().serial, Serial::from(30));
+    }
+
+    #[test]
+    fn no_client_release_for_consumed_or_never_delivered_press() {
+        let mut ledger = PointerButtons::default();
+        assert!(ledger.press(1, LEFT));
+        assert_eq!(ledger.release(&2, LEFT), None);
+        assert_eq!(ledger.release(&1, LEFT), None);
+        assert!(ledger.press(1, RIGHT));
+        assert!(ledger.forward(&1, RIGHT, Serial::from(10)));
+        assert_eq!(
+            ledger.remove_device(&1),
+            vec![ReleasedButton {
+                button: RIGHT,
+                serial: 10.into(),
+                sent: false
+            }]
+        );
+    }
+
+    #[test]
+    fn recreated_resource_does_not_inherit_old_suppression_or_ownership() {
+        // Distinct resource generations may reuse the same advertised name or
+        // Wayland protocol object number. The key is the full resource identity.
+        let old = ("pointer", 1);
+        let fresh = ("pointer", 2);
+        let mut ledger = PointerButtons::default();
+        assert!(ledger.press(old, LEFT));
+        assert!(ledger.press(fresh, LEFT));
+        assert!(ledger.forward(&fresh, LEFT, Serial::from(20)));
+        ledger.sent(LEFT);
+        assert!(ledger.remove_device(&old).is_empty());
+        assert_eq!(
+            ledger.release(&fresh, LEFT).unwrap().serial,
+            Serial::from(20)
+        );
+    }
+}
