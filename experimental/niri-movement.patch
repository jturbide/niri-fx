+#[test]
+fn consumed_binding_is_device_local_across_configuration_change() {
+    let config =
+        niri_config::Config::parse_mem("binds { MouseLeft { toggle-overview; }; }").unwrap();
+    let mut f = Fixture::with_config(config);
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let (b, pb) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    assert!(f.niri().layout.is_overview_open());
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    assert!(
+        f.niri().layout.is_overview_open(),
+        "duplicate press retriggered bind"
+    );
+    assert!(!seat.is_grabbed());
+    f.niri().config.borrow_mut().binds.0.clear();
+    f.niri().mods_with_mouse_binds.clear();
+    f.niri().layout.close_overview();
+    button(&mut f, b, &pb, LEFT, ButtonState::Pressed);
+    let serial = seat.with_grab(|serial, _| serial).unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Released);
+    assert!(seat.has_grab(serial));
+    pb.destroy();
+    f.roundtrip(b);
+    assert!(!seat.is_grabbed());
+}
