+fn resize_handoff_floor_is_independent_of_an_unrelated_swap() {
+    for vertical in [false, true] {
+        let mut reference = resize_three_sources(vertical);
+        let mut swapped = resize_three_sources(vertical);
+        for layout in [&mut reference, &mut swapped] {
+            resize_source_set_size(layout, 1, vertical, 1000);
+            Op::CompleteAnimations.apply(layout);
+            resize_source_set_size(layout, 1, vertical, 10);
+            Op::AdvanceAnimations { msec_delta: 950 }.apply(layout);
+            resize_source_set_size(layout, 1, vertical, 11);
+            Op::AdvanceAnimations { msec_delta: 100 }.apply(layout);
+            Op::FocusWindow(2).apply(layout);
+        }
+        let positions = |layout: &Layout<TestWindow>| {
+            let mut result: Vec<_> = layout
+                .active_workspace()
+                .unwrap()
+                .tiles_with_render_positions()
+                .map(|(tile, pos, _)| (*tile.window().id(), if vertical { pos.y } else { pos.x }))
+                .collect();
+            result.sort_by_key(|(id, _)| *id);
+            result
+        };
+        let before = positions(&swapped);
+        if vertical {
+            Op::MoveWindowDown.apply(&mut swapped);
+        } else {
+            Op::MoveColumnRight.apply(&mut swapped);
+        }
+        let after = positions(&swapped);
+        for ((id, before), (other, after)) in before.iter().zip(&after) {
+            assert_eq!(id, other);
+            assert!((before - after).abs() <= 1., "{before} -> {after}");
+        }
+        for _ in 0..110 {
+            for layout in [&mut reference, &mut swapped] {
+                Op::AdvanceAnimations { msec_delta: 10 }.apply(layout);
+                assert!(positions(layout).iter().all(|(_, value)| value.is_finite()));
+            }
+            let size = |layout: &Layout<TestWindow>| {
+                layout
+                    .active_workspace()
+                    .unwrap()
+                    .tiles()
+                    .find(|tile| *tile.window().id() == 1)
+                    .unwrap()
+                    .animated_tile_size()
+            };
+            assert_eq!(size(&reference), size(&swapped));
+        }
+        let ws = swapped.active_workspace().unwrap();
+        let mut tiles: Vec<_> = ws.tiles_with_render_positions().collect();
+        tiles.sort_by(|(_, a, _), (_, b, _)| {
+            if vertical {
+                a.y.total_cmp(&b.y)
+            } else {
+                a.x.total_cmp(&b.x)
+            }
+        });
+        for pair in tiles.windows(2) {
+            let (source, pos, _) = pair[0];
+            let (_, next, _) = pair[1];
+            let gap = if vertical {
+                next.y - pos.y - source.animated_tile_size().h
+            } else {
+                next.x - pos.x - source.animated_tile_size().w
+            };
+            assert!(gap.abs() <= 0.51, "{gap}");
+        }
+    }
+}
