+
+fn resize_handoff_layout_with_options(vertical: bool, options: Options) -> Layout<TestWindow> {
+    let mut layout = check_ops_with_options(
+        options,
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::AddWindow {
+                params: TestWindowParams::new(2),
+            },
+            Op::FocusColumnLeft,
+        ],
+    );
+    if vertical {
+        Op::ConsumeWindowIntoColumn.apply(&mut layout);
+    }
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::SetForcedSize {
+                id: 1,
+                size: Some(Size::new(100, 100)),
+            },
+            Op::SetForcedSize {
+                id: 2,
+                size: Some(Size::new(100, 100)),
+            },
+            Op::Communicate(1),
+            Op::Communicate(2),
+            Op::CompleteAnimations,
+        ],
+    );
+    layout
+}
+
+fn resize_handoff_set_size(layout: &mut Layout<TestWindow>, vertical: bool, extent: i32) {
+    resize_source_set_size(layout, 1, vertical, extent);
+}
+
+fn resize_source_set_size(layout: &mut Layout<TestWindow>, id: usize, vertical: bool, extent: i32) {
+    let mut size = layout
+        .active_workspace()
+        .unwrap()
+        .tiles()
+        .find(|tile| *tile.window().id() == id)
+        .unwrap()
+        .window()
+        .size();
+    if vertical {
+        size.h = extent;
+    } else {
+        size.w = extent;
+    }
+    let change = SizeChange::SetFixed(extent);
+    let request = if vertical {
+        Op::SetWindowHeight {
+            id: Some(id),
+            change,
+        }
+    } else {
+        Op::SetWindowWidth {
+            id: Some(id),
+            change,
+        }
+    };
+    check_ops_on_layout(
+        layout,
+        [
+            request,
+            Op::SetForcedSize {
+                id,
+                size: Some(size),
+            },
+            Op::Communicate(id),
+            Op::Communicate(2),
+        ],
+    );
+}
+
+fn resize_handoff_assert_neighbors(layout: &Layout<TestWindow>, vertical: bool) {
+    let ws = layout.active_workspace().unwrap();
+    let mut tiles: Vec<_> = ws.tiles_with_render_positions().collect();
+    tiles.sort_by_key(|(tile, _, _)| *tile.window().id());
+    let (first, pos, _) = tiles[0];
+    let (_, neighbor, _) = tiles[1];
+    let edge = if vertical {
+        pos.y + first.animated_tile_size().h
+    } else {
+        pos.x + first.animated_tile_size().w
+    };
+    let neighbor = if vertical { neighbor.y } else { neighbor.x };
+    assert!(
+        (edge - neighbor).abs() <= 0.51,
+        "resizing edge {edge} separated from neighbor {neighbor}"
+    );
+}
