+        resize_source_set_size(&mut layout, 2, vertical, 300);
+        Op::AdvanceAnimations { msec_delta: 200 }.apply(&mut layout);
+        Op::CloseWindow(1).apply(&mut layout);
+        Op::AdvanceAnimations { msec_delta: 180 }.apply(&mut layout);
