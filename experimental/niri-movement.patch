+fn resize_handoff_assert_neighbors(layout: &Layout<TestWindow>, vertical: bool) {
+    let ws = layout.active_workspace().unwrap();
+    let mut tiles: Vec<_> = ws.tiles_with_render_positions().collect();
+    tiles.sort_by_key(|(tile, _, _)| *tile.window().id());
+    let (first, pos, _) = tiles[0];
+    let (_, neighbor, _) = tiles[1];
+    let edge = if vertical {
+        pos.y + first.animated_tile_size().h
+    } else {
+        pos.x + first.animated_tile_size().w
+    };
+    let neighbor = if vertical { neighbor.y } else { neighbor.x };
+    assert!(
+        (edge - neighbor).abs() <= 0.51,
+        "resizing edge {edge} separated from neighbor {neighbor}"
+    );
+}
