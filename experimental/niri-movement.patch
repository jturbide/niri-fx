+fn compile_move_program(
+    renderer: &mut GlesRenderer,
+    src: &str,
+) -> Result<ShaderProgram, GlesError> {
+    let mut program = include_str!("move_prelude.frag").to_string();
+    program.push_str(src);
+    program.push_str(include_str!("move_epilogue.frag"));
+
+    ShaderProgram::compile(
+        renderer,
+        &program,
+        &[
+            UniformName::new("niri_input_to_geo", UniformType::Matrix3x3),
+            UniformName::new("niri_geo_size", UniformType::_2f),
+            UniformName::new("niri_geo_to_tex", UniformType::Matrix3x3),
+            UniformName::new("niri_progress", UniformType::_1f),
+            UniformName::new("niri_clamped_progress", UniformType::_1f),
+            UniformName::new("niri_random_seed", UniformType::_1f),
+            UniformName::new("niri_move_delta", UniformType::_2f),
+            UniformName::new("niri_move_impulse", UniformType::_2f),
+        ],
+        &["niri_tex"],
+    )
+}
+
+/// Compile and destroy a bounded probe without replacing the configured shader.
+/// A parser accepting custom-shader cannot establish that this renderer has the ABI.
+pub fn verify_move_contract(renderer: &mut GlesRenderer) -> bool {
+    let source = r#"
+        vec4 move_color(vec3 coords_geo, vec3 size_geo) {
+            vec2 uv = (niri_geo_to_tex * coords_geo).xy;
+            float probe = niri_clamped_progress + niri_progress + niri_random_seed
+                + dot(niri_move_delta + niri_move_impulse, size_geo.xy);
+            return texture2D(niri_tex, uv) * (0.5 + probe * 0.000001);
+        }
+    "#;
+    match compile_move_program(renderer, source) {
+        Ok(program) => program.destroy(renderer).is_ok(),
+        Err(_) => false,
+    }
+}
+
+pub fn set_custom_move_program(renderer: &mut GlesRenderer, src: Option<&str>) {
+    let program = if let Some(src) = src {
+        match compile_move_program(renderer, src) {
+            Ok(program) => Some(program),
+            Err(err) => {
+                warn!("error compiling custom move shader: {err:?}");
+                return;
+            }
+        }
+    } else {
+        None
+    };
+
+    if let Some(prev) = Shaders::get(renderer).replace_custom_move_program(program) {
+        if let Err(err) = prev.destroy(renderer) {
+            warn!("error destroying previous custom move shader: {err:?}");
+        }
+    }
+}
