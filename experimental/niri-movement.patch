+            near(
+                neighbor.as_ref().unwrap().offset(),
+                ordinary + first.value().w - 11. + second.value().w - 300.,
+            );
+        }
+        assert!(neighbor.unwrap().is_done());
+    }
+    #[test]
+    fn column_maximum_clock_ignores_a_later_finished_axis() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let first = SizeAnimation::new(
+            &phase(&clock),
+            Size::new(100., 100.),
+            Size::new(1000., 100.),
+            None,
+        );
+        clock.set_unadjusted(Duration::from_millis(200));
+        let shorter = Animation::ease(clock.clone(), 0., 1., 0., 100, Curve::Linear);
+        let second =
+            SizeAnimation::new(&shorter, Size::new(100., 100.), Size::new(200., 100.), None);
+        let mut maximum = None;
+        ResizePath::update_maximum(
+            &mut maximum,
+            1000.,
+            0.,
+            vec![
+                (Some(first.width.clone()), 1000.),
+                (Some(second.width.clone()), 200.),
+            ],
+        );
+        clock.set_unadjusted(Duration::from_millis(400));
+        let maximum = maximum.unwrap();
+        assert!(!maximum.is_done());
+        assert!(!maximum.animation().is_done());
+        assert_eq!(maximum.animation().end_time(), Duration::from_millis(1000));
+    }
+    #[test]
+    fn delayed_resize_reattachment_keeps_sampled_position_and_derivative() {
+        for delay in [0, 170, 550] {
+            let mut clock = Clock::with_time(Duration::ZERO);
+            let size = SizeAnimation::new(
+                &phase(&clock),
+                Size::new(1000., 100.),
+                Size::new(10., 100.),
+                None,
+            );
+            let mut neighbor = None;
+            MoveAnimation::follow_resize(&mut neighbor, size.width.clone(), 1., 990.);
+            clock.set_unadjusted(Duration::from_millis(400));
+            let previous = neighbor.take().unwrap();
+            neighbor = Some(
+                MoveAnimation::new(
+                    phase(&clock).restarted(1., 0., 0.),
+                    previous.offset() + 200.,
+                    Some(previous.velocity()),
+                )
+                .with_folded_sources(Some(&previous)),
+            );
+            clock.set_unadjusted(Duration::from_millis(400 + delay));
+            let before = neighbor.as_ref().unwrap().offset();
+            let velocity = neighbor.as_ref().unwrap().velocity();
+            let size = SizeAnimation::new(
+                &phase(&clock),
+                size.value(),
+                Size::new(11., 100.),
+                Some(size),
+            );
+            MoveAnimation::follow_resize(&mut neighbor, size.width.clone(), 1., -1.);
+            let neighbor = neighbor.unwrap();
+            near(neighbor.offset(), before - 1.);
+            near(neighbor.velocity(), velocity);
+            clock.set_unadjusted(Duration::from_micros((400 + delay) * 1000 + 1));
+            assert!(((neighbor.offset() - before + 1.) / 1e-6 - velocity).abs() < 0.02);
+            clock.set_unadjusted(Duration::from_secs(3));
+            assert!(neighbor.is_done());
+            near(neighbor.offset(), 0.);
+        }
+    }
+}
