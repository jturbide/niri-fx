+#[cfg(test)]
+mod resize_close_tests {
+    use super::*;
+    use crate::animation::{Clock, Curve};
+    use crate::utils::transaction::Transaction;
+    use std::time::Duration;
+
+    #[test]
+    fn waiting_close_keeps_fade_zero_without_restarting_retained_phase() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let phase = Animation::ease(clock.clone(), 0., 1., 0., 1000, Curve::Linear);
+        let transaction = Transaction::new();
+        let mut close = AnimationState::new(transaction.blocker(), phase.clone());
+        clock.set_unadjusted(Duration::from_millis(250));
+        close.advance();
+        assert_eq!(close.progress(), 0.);
+        assert_eq!(phase.clamped_value(), 0.25);
+        drop(transaction);
+        close.advance();
+        assert_eq!(close.progress(), 0.);
+        assert_eq!(phase.clamped_value(), 0.25);
+        clock.set_unadjusted(Duration::from_millis(500));
+        assert_eq!(close.progress(), 0.25);
+        assert_eq!(phase.clamped_value(), 0.5);
     }
 }
