index 0000000000000000000000000000000000000000..53fd50ac9063e235156f13510fa6883c01ec8be9
--- /dev/null
+++ b/src/animation/movement.rs
@@ -0,0 +1,255 @@
+//! Position continuity for the optional movement-shader experiment.
+//!
+//! Layout still owns the destination. Only an interrupted, opted-in movement
+//! uses a Hermite segment: its incoming position and velocity are preserved,
+//! and it reaches the new destination at rest on the original animation clock.
+
+use std::time::Duration;
+
+use super::Animation;
+
+#[derive(Debug)]
+pub(crate) struct MoveAnimation {
+    pub anim: Animation,
+    pub from: f64,
+    handoff: Option<Handoff>,
+}
+
+#[derive(Debug)]
+struct Handoff {
+    position: f64,
+    velocity: f64,
+    start: Duration,
+    end: Duration,
+}
+
+impl Handoff {
+    fn sample(&self, at: Duration) -> (f64, f64) {
+        let seconds = self.end.saturating_sub(self.start).as_secs_f64();
+        if seconds <= 0. || at >= self.end {
+            return (0., 0.);
+        }
+        let t = at.saturating_sub(self.start).as_secs_f64() / seconds;
+        let t2 = t * t;
+        let t3 = t2 * t;
+        let slope = self.velocity * seconds;
+        (
+            self.position * (2. * t3 - 3. * t2 + 1.) + slope * (t3 - 2. * t2 + t),
+            (self.position * (6. * t2 - 6. * t) + slope * (3. * t2 - 4. * t + 1.)) / seconds,
+        )
+    }
+}
+
+impl MoveAnimation {
+    /// `velocity` is in logical pixels per compositor-clock second, already
+    /// adjusted for slow motion. Do not apply the clock rate a second time.
+    pub fn new(anim: Animation, from: f64, velocity: Option<f64>) -> Self {
+        let handoff = velocity
+            .filter(|_| !anim.is_done())
+            .map(|velocity| Handoff {
+                position: from,
+                velocity,
+                start: anim.start_time(),
+                end: anim.end_time(),
+            });
+        Self {
+            anim,
+            from,
+            handoff,
+        }
+    }
+
+    pub fn offset(&self) -> f64 {
+        if let Some(handoff) = &self.handoff {
+            if self.anim.is_done() {
+                return 0.;
+            }
+            handoff.sample(self.anim.clock.now()).0
+        } else {
+            // Keep upstream behavior, including animations-off event-loop
+            // semantics, for initial moves and moves without a custom shader.
+            self.from * self.anim.value()
+        }
+    }
+
+    pub fn velocity(&self) -> f64 {
+        if self.anim.is_done() {
+            return 0.;
+        }
+        let at = self.anim.clock.now();
+        if let Some(handoff) = &self.handoff {
+            return handoff.sample(at).1;
+        }
+        // Sample upstream easing/spring equations instead of duplicating them.
+        // Use the unclamped value: a spring can cross its target before resting.
+        let step = Duration::from_micros(100);
+        let before = at.saturating_sub(step).max(self.anim.start_time());
+        let after = (at + step).min(self.anim.end_time());
+        if after <= before {
+            return 0.;
+        }
+        self.from * (self.anim.value_at(after) - self.anim.value_at(before))
+            / (after - before).as_secs_f64()
+    }
+
+    /// Adjust an ongoing layout offset without discarding its momentum or
+    /// extending its deadline. Upstream's tiny-tail behavior remains unchanged
+    /// for the ordinary animation path.
+    pub fn offset_current(&mut self, offset: f64) {
+        if self.handoff.is_some() && !self.anim.is_done() {
+            self.handoff = Some(Handoff {
+                position: self.offset() + offset,
+                velocity: self.velocity(),
+                start: self.anim.clock.now(),
+                end: self.anim.end_time(),
+            });
+        }
+        let value = self.anim.value();
+        if value > 0.001 {
+            self.from += offset / value;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::animation::{Clock, Curve, Spring, SpringParams};
+
+    fn ease(clock: &Clock) -> Animation {
+        Animation::ease(clock.clone(), 1., 0., 0., 1000, Curve::EaseOutCubic)
+    }
+
+    fn near(a: f64, b: f64) {
+        assert!((a - b).abs() < 1e-6, "{a} != {b}");
+    }
+
+    #[test]
+    fn reversals_preserve_position_and_velocity_and_settle() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let mut movement = MoveAnimation::new(ease(&clock), -700., None);
+        for (i, delta) in [700., -700., 700., -700., 0., 700.].into_iter().enumerate() {
+            clock.set_unadjusted(Duration::from_millis(120 * (i as u64 + 1)));
+            let old = movement.offset();
+            let speed = movement.velocity();
+            movement = MoveAnimation::new(ease(&clock), delta + old, Some(speed));
+            near(movement.offset() - delta, old);
+            near(movement.velocity(), speed);
+            // Check the rendered path's derivative, not just the stored value.
+            let now = clock.now();
+            clock.set_unadjusted(now + Duration::from_micros(1));
+            let measured = (movement.offset() - delta - old) / 1e-6;
+            assert!((measured - speed).abs() < 0.02);
+        }
+        clock.set_unadjusted(movement.anim.end_time());
+        near(movement.offset(), 0.);
+        near(movement.velocity(), 0.);
+    }
+
+    #[test]
+    fn zero_distance_can_retain_nonzero_momentum() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let movement = MoveAnimation::new(ease(&clock), 0., Some(500.));
+        near(movement.offset(), 0.);
+        near(movement.velocity(), 500.);
+        clock.set_unadjusted(Duration::from_millis(100));
+        assert!(movement.offset() > 0.);
+        clock.set_unadjusted(Duration::from_secs(1));
+        near(movement.offset(), 0.);
+    }
+
+    #[test]
+    fn layout_adjustments_keep_velocity_and_deadline() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let mut movement = MoveAnimation::new(ease(&clock), -500., Some(650.));
+        clock.set_unadjusted(Duration::from_millis(350));
+        let position = movement.offset();
+        let velocity = movement.velocity();
+        movement.offset_current(90.);
+        near(movement.offset(), position + 90.);
+        near(movement.velocity(), velocity);
+        clock.set_unadjusted(Duration::from_secs(1));
+        near(movement.offset(), 0.);
+    }
+
+    #[test]
+    fn ordinary_easing_and_spring_moves_keep_upstream_values() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let spring = Animation::spring(
+            clock.clone(),
+            Spring {
+                from: 1.,
+                to: 0.,
+                initial_velocity: 0.,
+                params: SpringParams::new(0.8, 800., 0.0001),
+            },
+        );
+        for anim in [ease(&clock), spring] {
+            let movement = MoveAnimation::new(anim.clone(), -500., None);
+            for milliseconds in [0, 10, 80, 180, 350, 1000] {
+                clock.set_unadjusted(Duration::from_millis(milliseconds));
+                near(movement.offset(), -500. * anim.value());
+            }
+        }
+    }
+
+    #[test]
+    fn spring_handoff_uses_actual_unclamped_velocity() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let anim = Animation::spring(
+            clock.clone(),
+            Spring {
+                from: 1.,
+                to: 0.,
+                initial_velocity: 0.,
+                params: SpringParams::new(0.3, 100., 0.0001),
+            },
+        );
+        let old = MoveAnimation::new(anim, -500., None);
+        clock.set_unadjusted(Duration::from_millis(220));
+        assert!(old.anim.is_clamped_done());
+        assert!(old.velocity().abs() > 1.);
+        let movement = MoveAnimation::new(ease(&clock), old.offset() + 500., Some(old.velocity()));
+        near(movement.velocity(), old.velocity());
+    }
+
+    #[test]
+    fn slow_and_frozen_clocks_do_not_rescale_velocity_twice() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        clock.set_rate(0.5);
+        let movement = MoveAnimation::new(ease(&clock), -500., Some(650.));
+        clock.set_unadjusted(Duration::from_millis(200));
+        near(
+            movement.offset(),
+            movement
+                .handoff
+                .as_ref()
+                .unwrap()
+                .sample(Duration::from_millis(100))
+                .0,
+        );
+        let position = movement.offset();
+        clock.set_rate(0.);
+        clock.set_unadjusted(Duration::from_millis(800));
+        near(movement.offset(), position);
+        clock.set_complete_instantly(true);
+        near(movement.offset(), 0.);
+        near(movement.velocity(), 0.);
+    }
+
+    #[test]
+    fn disabled_animation_preserves_event_loop_semantics() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let mut config = niri_config::animations::WindowMovementAnim::default().anim;
+        config.off = true;
+        let movement = MoveAnimation::new(
+            Animation::new(clock.clone(), 1., 0., 0., config),
+            -500.,
+            Some(650.),
+        );
+        near(movement.offset(), -500.);
+        assert!(movement.handoff.is_none());
+        clock.set_unadjusted(Duration::from_millis(1));
+        near(movement.offset(), 0.);
+    }
+}
