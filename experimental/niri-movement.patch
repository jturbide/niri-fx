+    }
+
+    pub fn retarget(&mut self, size: Size<f64, Logical>) {
+        self.content_size = size;
+        for target in self.targets.get_mut() {
+            // If this target has not rendered since the previous retarget,
+            // retain its existing base rather than discarding protected content.
+            if let Some(displayed) = target.displayed.take() {
+                target.previous = Some(displayed);
+            }
+        }
+    }
