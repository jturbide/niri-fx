+#[test]
+fn resize_handoff_focus_side_change_on_an_orthogonal_commit_keeps_the_old_deadline() {
+    let mut layout = resize_three_sources(false);
+    resize_source_set_size(&mut layout, 1, false, 500);
+    Op::AdvanceAnimations { msec_delta: 400 }.apply(&mut layout);
+    Op::FocusWindow(3).apply(&mut layout);
+    Op::AdvanceAnimations { msec_delta: 100 }.apply(&mut layout);
+    let before = resize_render_positions(&layout, false);
+    resize_source_set_size(&mut layout, 1, true, 200);
+    let after = resize_render_positions(&layout, false);
+    for ((_, before), (_, after)) in before.iter().zip(after) {
+        assert!((before - after).abs() <= 1., "{before} -> {after}");
+    }
+    for _ in 0..101 {
+        Op::AdvanceAnimations { msec_delta: 10 }.apply(&mut layout);
+        let ws = layout.active_workspace_mut().unwrap();
+        let mut raw: Vec<_> = ws
+            .tiles_with_render_positions_mut(false)
+            .map(|(tile, pos)| {
+                (
+                    *tile.window().id(),
+                    pos.x,
+                    tile.tile_size().w + tile.resize_path(true).map_or(0., |path| path.offset()),
+                )
+            })
+            .collect();
+        raw.sort_by_key(|(id, _, _)| *id);
+        for pair in raw.windows(2) {
+            assert!((pair[1].1 - pair[0].1 - pair[0].2).abs() < 1e-6, "{raw:?}");
