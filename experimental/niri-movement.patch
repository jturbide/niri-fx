@@ -0,0 +1,291 @@
+//! Exercise real virtual resource identity and destruction through the server.
+use smithay::input::pointer::{Focus, GrabStartData};
+use smithay::reexports::wayland_protocols_wlr::virtual_pointer::v1::client::{
+    zwlr_virtual_pointer_manager_v1::ZwlrVirtualPointerManagerV1,
+    zwlr_virtual_pointer_v1::ZwlrVirtualPointerV1,
+};
+use smithay::utils::SERIAL_COUNTER;
+use wayland_client::protocol::wl_pointer::ButtonState;
+use wayland_client::{delegate_noop, Proxy as _};
+
+use super::client::{ClientId, State as ClientState};
+use super::Fixture;
+use crate::input::pick_window_grab::PickWindowGrab;
+use crate::input::spatial_movement_grab::SpatialMovementGrab;
+
+const LEFT: u32 = 0x110;
+const RIGHT: u32 = 0x111;
+
+delegate_noop!(ClientState: ZwlrVirtualPointerManagerV1);
+delegate_noop!(ClientState: ZwlrVirtualPointerV1);
+
+fn virtual_pointer(f: &mut Fixture) -> (ClientId, ZwlrVirtualPointerV1) {
+    let id = f.add_client();
+    let client = f.client(id);
+    let global = client
+        .state
+        .globals
+        .iter()
+        .find(|g| g.interface == ZwlrVirtualPointerManagerV1::interface().name)
+        .unwrap();
+    let registry = client.display.get_registry(&client.qh, ());
+    let manager: ZwlrVirtualPointerManagerV1 = registry.bind(global.name, 1, &client.qh, ());
+    let pointer = manager.create_virtual_pointer(None, &client.qh, ());
+    f.roundtrip(id);
+    (id, pointer)
+}
+
+fn button(
+    f: &mut Fixture,
+    id: ClientId,
+    pointer: &ZwlrVirtualPointerV1,
+    code: u32,
+    state: ButtonState,
+) {
+    pointer.button(1, code, state);
+    pointer.frame();
+    f.roundtrip(id);
+}
+
+#[test]
+fn same_protocol_ids_in_different_clients_share_only_the_logical_seat_press() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let (b, pb) = virtual_pointer(&mut f);
+    assert_eq!(pa.id().protocol_id(), pb.id().protocol_id());
+    let seat = f.niri().seat.get_pointer().unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    let serial = seat.with_grab(|serial, _| serial).unwrap();
+    button(&mut f, b, &pb, LEFT, ButtonState::Pressed);
+    button(&mut f, a, &pa, LEFT, ButtonState::Released);
+    assert!(seat.has_grab(serial));
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(seat.has_grab(serial));
+    button(&mut f, b, &pb, LEFT, ButtonState::Released);
+    assert!(!seat.is_grabbed());
+}
+
+#[test]
+fn owner_destroy_releases_but_idle_destroy_does_not_cancel() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let (b, pb) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    let serial = seat.with_grab(|serial, _| serial).unwrap();
+    pb.destroy();
+    f.roundtrip(b);
+    assert!(seat.has_grab(serial));
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(!seat.is_grabbed());
+}
+
+#[test]
+fn destroying_one_same_button_owner_preserves_the_remaining_owner() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let (b, pb) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    button(&mut f, b, &pb, LEFT, ButtonState::Pressed);
+    let serial = seat.with_grab(|serial, _| serial).unwrap();
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(seat.has_grab(serial));
+    pb.destroy();
+    f.roundtrip(b);
+    assert!(!seat.is_grabbed());
+}
+
+#[test]
+fn consumed_picker_press_cannot_suppress_or_own_another_clients_press() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let (b, pb) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    let start = GrabStartData {
+        focus: None,
+        button: 0,
+        location: (0., 0.).into(),
+    };
+    seat.set_grab(
+        f.niri_state(),
+        PickWindowGrab::new(start),
+        SERIAL_COUNTER.next_serial(),
+        Focus::Clear,
+    );
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    assert!(!seat.is_grabbed());
+    button(&mut f, b, &pb, LEFT, ButtonState::Pressed);
+    let serial = seat.with_grab(|serial, _| serial).unwrap();
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(seat.has_grab(serial));
+    button(&mut f, b, &pb, LEFT, ButtonState::Released);
+    assert!(!seat.is_grabbed());
+}
+
+#[test]
+fn device_removal_preserves_a_new_keyboard_started_picker_grab() {
+    let mut f = Fixture::new();
+    f.add_output(1, (1280, 800));
+    let (a, pa) = virtual_pointer(&mut f);
+    let seat = f.niri().seat.get_pointer().unwrap();
+    button(&mut f, a, &pa, LEFT, ButtonState::Pressed);
+    let start = GrabStartData {
+        focus: None,
+        button: 0,
+        location: (0., 0.).into(),
+    };
+    let picker_serial = SERIAL_COUNTER.next_serial();
+    seat.set_grab(
+        f.niri_state(),
+        PickWindowGrab::new(start),
+        picker_serial,
+        Focus::Clear,
+    );
+    pa.destroy();
+    f.roundtrip(a);
+    assert!(seat.has_grab(picker_serial));
+}
