+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::animation::{Clock, Curve};
+    use std::time::Duration;
+
+    #[test]
+    fn retained_resize_requires_explicit_supported_marker() {
+        assert!(supports_retained_material(
+            " // niri-fx resize-continuity: 1 \nvoid main() {}"
+        ));
+        for source in [
+            "",
+            "// niri-fx resize-continuity: 2",
+            "// niri-fx resize-continuity: 10",
+            "// explanation: // niri-fx resize-continuity: 1",
+        ] {
+            assert!(!supports_retained_material(source));
+        }
+    }
+
+    #[test]
+    fn retained_resize_keeps_phase_and_material_coordinates_through_retargets() {
+        let mut clock = Clock::with_time(Duration::ZERO);
+        let phase = Animation::ease(clock.clone(), 0., 1., 0., 1000, Curve::Linear);
+        let from = Size::new(400., 300.);
+        let to = Size::new(800., 600.);
+        let mut material = ResizeMaterial::new(phase, from, to);
+        clock.set_unadjusted(Duration::from_millis(350));
+        for target in [
+            Size::new(200., 600.),
+            Size::new(1000., 200.),
+            Size::new(400., 300.),
+        ] {
+            material.retarget(target);
+            assert_eq!(material.phase.value(), 0.35);
+            assert_eq!(material.reference_size, to);
+            assert_eq!(material.reference_from_size, from);
+            assert_eq!(material.reference_to_size, to);
+            assert_eq!(material.content_size, target);
+            assert_eq!(material.targets.borrow().len(), 3);
+        }
+        clock.set_unadjusted(Duration::from_millis(1000));
+        assert!(material.phase.is_done());
+        assert_eq!(material.phase.value(), 1.);
+    }
+}
