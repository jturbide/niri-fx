+++ b/src/layout/resize_close.rs
@@ -0,0 +1,334 @@
+//! Frozen, target-separated material for resize-to-close handoff.
+use std::cell::RefCell;
+
+use anyhow::Context as _;
+use smithay::backend::allocator::Fourcc;
+use smithay::backend::renderer::element::{Element as _, Kind};
+use smithay::backend::renderer::gles::{GlesRenderer, GlesTexture};
+use smithay::backend::renderer::{ContextId, Renderer as _};
+use smithay::utils::{Logical, Point, Rectangle, Scale, Size, Transform};
+
+use super::focus_ring::FocusRing;
+use super::shadow::Shadow;
+use super::tile::TileRenderElement;
+use crate::animation::SizeAnimation;
+use crate::render_helpers::offscreen::OffscreenBuffer;
+use crate::render_helpers::resize::FrozenResizeMaterial;
+use crate::render_helpers::texture::{TextureBuffer, TextureRenderElement};
+use crate::render_helpers::{render_to_encompassing_texture, RenderTarget};
+
+/// Commit only a complete target set. On any allocation/render error, Rust drops
+/// every earlier target and the caller keeps its separately protected snapshot.
+pub(super) fn capture_targets<T, E>(
+    mut capture: impl FnMut(RenderTarget) -> Result<T, E>,
+) -> Result<[T; 3], E> {
+    Ok([
+        capture(RenderTarget::Output)?,
+        capture(RenderTarget::Screencast)?,
+        capture(RenderTarget::ScreenCapture)?,
+    ])
+}
+
+#[derive(Debug)]
+struct Plane {
+    buffer: TextureBuffer<GlesTexture>,
+    offset: Point<f64, Logical>,
+}
+
+impl Plane {
+    fn capture(
+        renderer: &mut GlesRenderer,
+        scale: Scale<f64>,
+        elements: Vec<TileRenderElement<GlesRenderer>>,
+    ) -> anyhow::Result<Option<Self>> {
+        if elements.is_empty() {
+            return Ok(None);
+        }
+        let result = render_to_encompassing_texture(
+            renderer,
+            scale,
+            Transform::Normal,
+            Fourcc::Abgr8888,
+            &elements,
+        );
+        // Neutralize offscreen binding before the caller rebinds its EGL surface,
+        // including the allocation/render failure path.
+        renderer.with_context(|gl| unsafe {
+            gl.BindFramebuffer(smithay::backend::renderer::gles::ffi::FRAMEBUFFER, 0);
+        })?;
+        let (texture, _, geo) = result.context("freezing resize decoration plane")?;
+        Ok(Some(Self {
+            buffer: TextureBuffer::from_texture(
+                renderer,
+                texture,
+                scale,
+                Transform::Normal,
+                Vec::new(),
+            ),
+            offset: geo.loc.to_f64().to_logical(scale),
+        }))
+    }
+
+    fn render(
+        &self,
+        offset: Point<f64, Logical>,
+        ratio: Size<f64, Logical>,
+    ) -> TextureRenderElement<GlesTexture> {
+        let location = Point::new(self.offset.x * ratio.w, self.offset.y * ratio.h) + offset;
+        let size = self.buffer.logical_size();
+        TextureRenderElement::from_texture_buffer(
+            self.buffer.clone(),
+            location,
+            1.,
+            Some(Rectangle::from_size(size)),
+            Some(Size::new(size.w * ratio.w, size.h * ratio.h)),
+            Kind::Unspecified,
+        )
+    }
+}
+
+#[derive(Debug)]
+pub struct ResizeClosingTarget {
+    material: FrozenResizeMaterial,
+    front: Option<Plane>,
+    back: Option<Plane>,
+    composite: OffscreenBuffer,
+}
+
+impl ResizeClosingTarget {
+    pub fn capture(
+        renderer: &mut GlesRenderer,
+        scale: Scale<f64>,
+        elements: Vec<TileRenderElement<GlesRenderer>>,
+    ) -> anyhow::Result<Self> {
+        let mut front = Vec::new();
+        let mut back = Vec::new();
+        let mut material = None;
+        for element in elements {
+            match element {
+                TileRenderElement::Resize(element) => {
+                    anyhow::ensure!(material.is_none(), "multiple resize materials in tile");
+                    material = element.into_frozen();
+                    anyhow::ensure!(
+                        material.is_some(),
+                        "resize material has no retained program"
+                    );
+                }
+                element if material.is_none() => front.push(element),
+                element => back.push(element),
+            }
+        }
+        let material = material.context("resize material unavailable")?;
+        Ok(Self {
+            material,
+            front: Plane::capture(renderer, scale, front)?,
+            back: Plane::capture(renderer, scale, back)?,
+            composite: OffscreenBuffer::default(),
+        })
+    }
+}
+
+/// All three targets must freeze successfully before this continuation is used.
+/// Failure retains the ordinary protected snapshot; targets never borrow Output.
+#[derive(Debug)]
+pub struct ResizeClosing {
+    targets: [ResizeClosingTarget; 3],
+    context: ContextId<GlesTexture>,
+    capture_scale: Scale<f64>,
+    window: SizeAnimation,
+    tile: SizeAnimation,
+    original_tile_size: Size<f64, Logical>,
+    original_window_location: Point<f64, Logical>,
+    border: RefCell<FocusRing>,
+    shadow: RefCell<Shadow>,
+    border_width: Option<f64>,
+    shadow_visible: bool,
+    bob_offset: Point<f64, Logical>,
+    pub alpha: f32,
+}
+
+impl ResizeClosing {
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn new(
+        renderer: &mut GlesRenderer,
+        targets: [ResizeClosingTarget; 3],
+        capture_scale: Scale<f64>,
+        window: SizeAnimation,
+        tile: SizeAnimation,
+        original_tile_size: Size<f64, Logical>,
+        original_window_location: Point<f64, Logical>,
+        border: FocusRing,
+        shadow: Shadow,
+        border_width: Option<f64>,
+        shadow_visible: bool,
+        bob_offset: Point<f64, Logical>,
+        alpha: f32,
+    ) -> Self {
+        Self {
+            targets,
+            context: renderer.context_id(),
+            capture_scale,
+            window,
+            tile,
+            original_tile_size,
+            original_window_location,
+            border: RefCell::new(border),
+            shadow: RefCell::new(shadow),
+            border_width,
+            shadow_visible,
+            bob_offset,
+            alpha,
+        }
+    }
+
+    pub fn matches_scale(&self, scale: Scale<f64>) -> bool {
+        self.capture_scale == scale
+    }
+
+    pub fn render(
+        &self,
+        renderer: &mut GlesRenderer,
+        target: RenderTarget,
+        scale: Scale<f64>,
+    ) -> anyhow::Result<(
+        TextureBuffer<GlesTexture>,
+        Point<f64, Logical>,
+        Size<f64, Logical>,
+    )> {
+        anyhow::ensure!(
+            self.context == renderer.context_id(),
+            "resize closing renderer was replaced"
+        );
+        let target = &self.targets[target as usize];
+        let window_size = self
+            .window
+            .value()
+            .to_physical_precise_round(scale)
+            .to_logical(scale);
+        let tile_size = self
+            .tile
+            .value()
+            .to_physical_precise_round(scale)
+            .to_logical(scale);
+        let window_location = Point::new(
+            (tile_size.w - window_size.w) / 2.,
+            (tile_size.h - window_size.h) / 2.,
+        )
+        .to_physical_precise_round(scale)
+        .to_logical(scale);
+        let mut elements: Vec<TileRenderElement<GlesRenderer>> = Vec::new();
+        if let Some(front) = &target.front {
+            elements.push(
+                crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement(
+                    front.render(
+                        window_location - self.original_window_location,
+                        Size::new(1., 1.),
+                    ),
+                )
+                .into(),
+            );
+        }
+        let material =
+            target
+                .material
+                .render(window_size, window_location + self.bob_offset, scale);
+        elements.push(material.into());
+        if let Some(width) = self.border_width {
+            let mut border = self.border.borrow_mut();
+            border.resize_frozen(
+                Size::new(
+                    (tile_size.w - 2. * width).max(0.),
+                    (tile_size.h - 2. * width).max(0.),
+                ),
+                scale.x,
+            );
+            border.render(
+                renderer,
+                self.bob_offset + Point::new(width, width),
+                &mut |elem| elements.push(elem.into()),
+            );
+        }
+        if self.shadow_visible {
+            let mut shadow = self.shadow.borrow_mut();
+            shadow.resize_frozen(tile_size, scale.x);
+            shadow.render(renderer, self.bob_offset, &mut |elem| {
+                elements.push(elem.into())
+            });
+        }
+        if let Some(back) = &target.back {
+            let ratio = Size::new(
+                tile_size.w / self.original_tile_size.w,
+                tile_size.h / self.original_tile_size.h,
+            );
+            elements.push(
+                crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement(
+                    back.render(Point::new(0., 0.), ratio),
+                )
+                .into(),
+            );
+        }
+        let result = target.composite.render(renderer, scale, &elements);
+        renderer.with_context(|gl| unsafe {
+            gl.BindFramebuffer(smithay::backend::renderer::gles::ffi::FRAMEBUFFER, 0);
+        })?;
+        let (element, _, _) = result?;
+        let offset = element.geometry(scale).loc.to_f64().to_logical(scale);
+        let texture = TextureBuffer::from_texture(
+            renderer,
+            element.texture().clone(),
+            scale,
+            Transform::Normal,
+            Vec::new(),
+        );
+        Ok((texture, offset, tile_size))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    #[test]
+    fn freezing_is_atomic_for_each_target_failure() {
+        struct Allocation(Rc<Cell<usize>>);
+        impl Drop for Allocation {
+            fn drop(&mut self) {
+                self.0.set(self.0.get() - 1);
+            }
+        }
+        for failure in 0..3 {
+            let live = Rc::new(Cell::new(0));
+            let mut visited = Vec::new();
+            let result = capture_targets(|target| {
+                visited.push(target);
+                if target as usize == failure {
+                    return Err(());
+                }
+                live.set(live.get() + 1);
+                Ok(Allocation(live.clone()))
+            });
+            assert!(result.is_err());
+            assert_eq!(live.get(), 0, "partial GPU ownership must be released");
+            assert_eq!(
+                visited.len(),
+                failure + 1,
+                "never substitute a different target"
+            );
+        }
+    }
+
+    #[test]
+    fn freezing_keeps_three_independent_target_slots() {
+        let targets: [RenderTarget; 3] = capture_targets(|target| Ok::<_, ()>(target)).unwrap();
+        assert_eq!(
+            targets,
+            [
+                RenderTarget::Output,
+                RenderTarget::Screencast,
+                RenderTarget::ScreenCapture
+            ]
+        );
+    }
+}
