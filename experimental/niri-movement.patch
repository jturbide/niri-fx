+    pub reference_to_size: Size<f64, Logical>,
+    pub content_size: Size<f64, Logical>,
+    targets: RefCell<[TargetMaterial; 3]>,
+    program: RefCell<Option<ShaderProgram>>,
+    context: RefCell<Option<ContextId<GlesTexture>>>,
+    ignore_snapshot: Cell<bool>,
+}
+
+impl ResizeMaterial {
+    pub fn new(phase: Animation, from: Size<f64, Logical>, to: Size<f64, Logical>) -> Self {
+        Self {
+            phase,
+            reference_size: to,
+            reference_from_size: from,
+            reference_to_size: to,
+            content_size: to,
+            targets: RefCell::new(std::array::from_fn(|_| TargetMaterial::default())),
+            program: RefCell::new(None),
+            context: RefCell::new(None),
+            ignore_snapshot: Cell::new(false),
+        }
+    }
+
+    pub fn retarget(&mut self, size: Size<f64, Logical>) {
+        self.content_size = size;
+        for target in self.targets.get_mut() {
+            // If this target has not rendered since the previous retarget,
+            // retain its existing base rather than discarding protected content.
+            if let Some(displayed) = target.displayed.take() {
+                target.previous = Some(displayed);
+            }
+        }
+    }
+
+    pub fn program(&self, renderer: &mut GlesRenderer) -> Option<ShaderProgram> {
+        let context = renderer.context_id();
+        let changed = self
+            .context
+            .borrow()
+            .as_ref()
+            .is_some_and(|old| *old != context);
+        if changed {
+            // GL object names belong to a context. Never reinterpret retained textures or
+            // programs after renderer recreation. The old snapshot can also be cached in
+            // the previous context, so use current content for the rest of this episode.
+            self.targets
+                .replace(std::array::from_fn(|_| TargetMaterial::default()));
+            self.program.replace(None);
+            self.ignore_snapshot.set(true);
+        }
+        self.context.replace(Some(context));
+        let mut program = self.program.borrow_mut();
+        if program.is_none() {
+            *program = Shaders::get(renderer).program(ProgramType::Resize);
+        }
+        program.clone()
+    }
+
+    pub fn ignores_snapshot(&self) -> bool {
+        self.ignore_snapshot.get()
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn composite(
+        &self,
+        renderer: &mut GlesRenderer,
+        target: RenderTarget,
+        scale: Scale<f64>,
+        material_size: Size<f64, Logical>,
+        previous: (GlesTexture, Rectangle<i32, Physical>),
+        previous_size: Size<f64, Logical>,
+        current: (GlesTexture, Rectangle<i32, Physical>),
+        current_size: Size<f64, Logical>,
+        progress: f32,
+        blocked: bool,
+    ) -> anyhow::Result<(GlesTexture, Rectangle<i32, Physical>)> {
+        anyhow::ensure!(
+            Shaders::get(renderer)
+                .program(ProgramType::ResizeContent)
+                .is_some(),
+            "resize content shader is unavailable"
+        );
+        let mut targets = self.targets.borrow_mut();
+        let cache = &mut targets[target as usize];
+        // A texture rendered for one capture target is never reused for another.
+        // A scale change starts a fresh content blend from the safe snapshot;
+        // reinterpreting cached pixel coordinates at the new scale is incorrect.
+        if cache.scale.is_some_and(|old| old != scale) {
+            cache.previous = None;
+            cache.displayed = None;
+        }
+        if cache.blocked.is_some_and(|old| old != blocked) {
+            // A policy boundary starts a new source generation in both directions.
+            // Retain current raw content, so later frames cannot fall back to a
+            // snapshot from the previous policy or promote an old redacted blend.
+            cache.previous = Some(MaterialTexture {
+                texture: current.clone(),
+                size: current_size,
+            });
+            cache.displayed = None;
+        }
+        cache.scale = Some(scale);
+        cache.blocked = Some(blocked);
+        let (previous, previous_size) = if blocked || self.ignore_snapshot.get() {
+            (current.clone(), current_size)
+        } else {
+            (previous, previous_size)
+        };
+        let (previous, previous_size) = cache
+            .previous
+            .as_ref()
+            .map(|previous| (previous.texture.clone(), previous.size))
+            .unwrap_or((previous, previous_size));
+        cache.displayed = None;
+        let element = ResizeRenderElement::new(
+            Rectangle::new(Point::from((0., 0.)), material_size),
+            scale,
+            previous,
+            previous_size,
+            current,
+            current_size,
+            progress,
+            progress,
+            CornerRadius::default(),
+            false,
+            1.,
+            ProgramType::ResizeContent,
+            None,
+        );
+        let composite = cache.composite.render(renderer, scale, &[element]);
+        // Restore the default framebuffer before EGL rebinds a window surface.
+        // Leaving an offscreen FBO current across that transition can preserve
+        // GL_NONE as the window's default read/draw buffer on surfaceless EGL.
+        // This must also run before the safe-content fallback on render errors.
+        renderer.with_context(|gl| unsafe {
+            gl.BindFramebuffer(smithay::backend::renderer::gles::ffi::FRAMEBUFFER, 0);
+        })?;
+        let (element, _, _) = composite?;
+        let texture = (element.texture().clone(), element.geometry(scale));
+        cache.displayed = Some(MaterialTexture {
+            texture: texture.clone(),
+            size: material_size,
+        });
+        Ok(texture)
+    }
+}
