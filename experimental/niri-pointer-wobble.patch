diff --git a/src/render_helpers/shaders/pointer_wobble.frag b/src/render_helpers/shaders/pointer_wobble.frag
new file mode 100644
index 0000000000000000000000000000000000000000..28194b553a0d5f5a89190c191d8daaa3cb987d5a
--- /dev/null
+++ b/src/render_helpers/shaders/pointer_wobble.frag
@@ -0,0 +1,41 @@
+precision highp float;
+varying vec2 niri_v_coords;
+uniform mat3 niri_input_to_geo;
+uniform mat3 niri_geo_to_tex;
+uniform vec2 niri_geo_size;
+uniform sampler2D niri_tex;
+uniform float niri_alpha;
+uniform vec2 niri_pointer_anchor;
+uniform vec2 niri_pointer_deformation;
+#if defined(DEBUG_FLAGS)
+uniform float niri_tint;
+#endif
+
+// The grabbed point remains fixed, while distant material lags behind it.
+// Restricting deformation to 12% of the short side keeps the map invertible
+// even for tiny windows. All math is in logical pixels, independent of scale.
+vec2 displacement(vec2 uv, vec2 shift) {
+    vec2 relative = uv - niri_pointer_anchor;
+    float weight = min(dot(relative, relative), 1.0);
+    return shift * weight;
+}
+void main() {
+    vec2 dest = (niri_input_to_geo * vec3(niri_v_coords, 1.0)).xy;
+    float limit = min(64.0, min(niri_geo_size.x, niri_geo_size.y) * 0.12);
+    float magnitude = length(niri_pointer_deformation);
+    vec2 shift = niri_pointer_deformation * min(1.0, limit / max(magnitude, 0.0001));
+    shift /= max(niri_geo_size, vec2(1.0));
+    // Fixed-point inverse sampling prevents holes and retains antialiased CSD.
+    vec2 source = dest;
+    for (int i = 0; i < 5; i++) {
+        source = dest - displacement(source, shift);
+    }
+    vec2 uv = (niri_geo_to_tex * vec3(source, 1.0)).xy;
+    vec4 color = texture2D(niri_tex, uv);
+    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) color = vec4(0.0);
+    color *= niri_alpha;
+#if defined(DEBUG_FLAGS)
+    if (niri_tint == 1.0) color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+    gl_FragColor = color;
+}
