index 0000000000000000000000000000000000000000..8228adf6e9592948004f56109b30e350c0a5ae89
--- /dev/null
+++ b/src/animation/pointer_wobble.rs
@@ -0,0 +1,291 @@
+//! Bounded pointer-driven deformation, independent of layout and hit testing.
+//!
+//! Pointer deltas add spring velocity instead of teleporting the deformation.
+//! The analytical solution is invariant to render frequency, repeated capture
+//! passes and long frames. The tile itself always follows Niri's normal grab.
+use std::f64::consts::TAU;
+use std::time::Duration;
+
+use niri_config::animations::PointerWobble as Config;
+use smithay::utils::{Logical, Point};
+
+pub const MAX_DEFORMATION: f64 = 64.;
+const MAX_RELEASE: Duration = Duration::from_secs(2);
+
+#[derive(Debug, Clone)]
+pub struct PointerWobble {
+    config: Config,
+    position: Point<f64, Logical>,
+    velocity: Point<f64, Logical>,
+    sampled_at: Duration,
+    released_at: Option<Duration>,
+    anchor_from: Point<f64, Logical>,
+    anchor_to: Point<f64, Logical>,
+    anchor_at: Duration,
+}
+
+impl PointerWobble {
+    pub fn new(config: Config, anchor: Point<f64, Logical>, now: Duration) -> Self {
+        Self {
+            config,
+            position: Point::from((0., 0.)),
+            velocity: Point::from((0., 0.)),
+            sampled_at: now,
+            released_at: None,
+            anchor_from: anchor,
+            anchor_to: anchor,
+            anchor_at: now,
+        }
+    }
+
+    pub fn grab(&mut self, anchor: Point<f64, Logical>, now: Duration) {
+        self.advance(now);
+        let (envelope, derivative) = self.envelope();
+        self.velocity = self.velocity.upscale(envelope) + self.position.upscale(derivative);
+        self.position = self.position.upscale(envelope);
+        self.anchor_from = self.anchor(now);
+        self.anchor_to = anchor;
+        self.anchor_at = now;
+        self.released_at = None;
+    }
+
+    pub fn push(&mut self, delta: Point<f64, Logical>, now: Duration) {
+        if !delta.x.is_finite() || !delta.y.is_finite() {
+            return;
+        }
+        self.advance(now);
+        if self.released() {
+            // Defensive callers may resume with a motion event first.
+            self.grab(self.anchor(now), now);
+        }
+        let omega = TAU * f64::from(self.config.frequency);
+        let delta = Point::from((delta.x.clamp(-1e6, 1e6), delta.y.clamp(-1e6, 1e6)));
+        self.velocity -= delta.upscale(omega * self.config.strength.0);
+        // Restrict the new velocity to remaining spring energy. Never rescale
+        // existing displacement: doing so would visibly jump on rapid input.
+        let radius = self.position.x.hypot(self.position.y).min(MAX_DEFORMATION);
+        let max_velocity = omega * (MAX_DEFORMATION.powi(2) - radius.powi(2)).sqrt();
+        let speed = self.velocity.x.hypot(self.velocity.y);
+        if speed > max_velocity {
+            self.velocity = self.velocity.upscale(max_velocity / speed);
+        }
+    }
+
+    pub fn release(&mut self, now: Duration) {
+        self.advance(now);
+        self.released_at = Some(now);
+    }
+
+    pub fn released(&self) -> bool {
+        self.released_at.is_some()
+    }
+
+    pub fn anchor(&self, now: Duration) -> Point<f64, Logical> {
+        let t = (now.saturating_sub(self.anchor_at).as_secs_f64() / 0.08).min(1.);
+        if t >= 1. {
+            return self.anchor_to;
+        }
+        let mix = t * t * (3. - 2. * t);
+        self.anchor_from + (self.anchor_to - self.anchor_from).upscale(mix)
+    }
+
+    // The slowest allowed spring can still carry energy at the two-second
+    // ownership deadline. A time-based quintic taper reaches rest smoothly;
+    // sampling it does not alter the spring or depend on frame frequency.
+    fn envelope(&self) -> (f64, f64) {
+        let Some(released_at) = self.released_at else {
+            return (1., 0.);
+        };
+        let elapsed = self.sampled_at.saturating_sub(released_at).as_secs_f64();
+        let t = ((elapsed - 1.5) / 0.5).clamp(0., 1.);
+        let smooth = t.powi(3) * (10. - 15. * t + 6. * t.powi(2));
+        let derivative = -30. * t.powi(2) * (1. - t).powi(2) / 0.5;
+        (1. - smooth, derivative)
+    }
+
+    pub fn deformation(&self) -> Point<f64, Logical> {
+        self.position.upscale(self.envelope().0)
+    }
+
+    pub fn is_moving(&self) -> bool {
+        self.position.x.abs() + self.position.y.abs() > 0.01
+            || self.velocity.x.abs() + self.velocity.y.abs() > 0.1
+    }
+
+    pub fn advance(&mut self, now: Duration) {
+        let dt = now.saturating_sub(self.sampled_at).as_secs_f64();
+        self.sampled_at = self.sampled_at.max(now);
+        if self
+            .released_at
+            .is_some_and(|at| now.saturating_sub(at) >= MAX_RELEASE)
+        {
+            self.position = Point::from((0., 0.));
+            self.velocity = Point::from((0., 0.));
+            return;
+        }
+        let omega = TAU * f64::from(self.config.frequency);
+        let damping = f64::from(self.config.damping) / 100.;
+        let decay = (-damping * omega * dt).exp();
+        let sample = |x: f64, v: f64| {
+            if damping >= 1. {
+                let b = v + omega * x;
+                ((x + b * dt) * decay, (v - omega * b * dt) * decay)
+            } else {
+                let rate = damping * omega;
+                let wd = omega * (1. - damping * damping).sqrt();
+                let (sin, cos) = (wd * dt).sin_cos();
+                let b = (v + rate * x) / wd;
+                let position = decay * (x * cos + b * sin);
+                let velocity = decay * (v * cos - (rate * b + wd * x) * sin);
+                (position, velocity)
+            }
+        };
+        let (x, vx) = sample(self.position.x, self.velocity.x);
+        let (y, vy) = sample(self.position.y, self.velocity.y);
+        self.position = Point::from((x, y));
+        self.velocity = Point::from((vx, vy));
+        if !self.is_moving() {
+            self.position = Point::from((0., 0.));
+            self.velocity = Point::from((0., 0.));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn make() -> PointerWobble {
+        PointerWobble::new(Config::default(), Point::from((0.2, 0.3)), Duration::ZERO)
+    }
+    fn at(ms: u64) -> Duration {
+        Duration::from_millis(ms)
+    }
+    fn near(a: f64, b: f64) {
+        assert!((a - b).abs() < 1e-8, "{a} != {b}");
+    }
+
+    #[test]
+    fn impulses_preserve_position_and_release_preserves_velocity() {
+        let mut state = make();
+        state.push(Point::from((40., -15.)), Duration::ZERO);
+        assert_eq!(state.position, Point::from((0., 0.)));
+        state.advance(at(16));
+        assert!(state.position.x < 0. && state.position.y > 0.);
+        let before = state.clone();
+        state.release(at(16));
+        assert_eq!(state.position, before.position);
+        assert_eq!(state.velocity, before.velocity);
+        assert!(state.released());
+        state.advance(at(100));
+        assert!(state.is_moving());
+        state.advance(at(2016));
+        assert!(!state.is_moving());
+    }
+
+    #[test]
+    fn solution_is_independent_of_frame_rate_and_duplicate_renders() {
+        let mut one = make();
+        one.push(Point::from((60., 40.)), Duration::ZERO);
+        let mut many = one.clone();
+        one.advance(at(120));
+        for i in 1..=120 {
+            many.advance(at(i));
+            many.advance(at(i));
+        }
+        near(one.position.x, many.position.x);
+        near(one.velocity.x, many.velocity.x);
+        near(one.position.y, many.position.y);
+    }
+
+    #[test]
+    fn adversarial_pointer_bursts_remain_bounded() {
+        let mut state = make();
+        for i in 0..1000 {
+            state.push(
+                Point::from((1e6 * if i % 2 == 0 { 1. } else { -1. }, -1e6)),
+                at(i),
+            );
+            state.advance(at(i + 1));
+            assert!(state.position.x.hypot(state.position.y) <= MAX_DEFORMATION + 1e-6);
+        }
+        state.push(Point::from((1e308, -1e308)), at(1000));
+        assert!(state.position.x.is_finite());
+        assert!(state.velocity.x.is_finite());
+        state.release(at(1000));
+        state.advance(at(5000));
+        assert!(!state.is_moving());
+    }
+
+    #[test]
+    fn repeat_grab_keeps_motion_and_blends_anchor() {
+        let mut state = make();
+        state.push(Point::from((50., 0.)), Duration::ZERO);
+        state.release(at(16));
+        let before = state.clone();
+        state.grab(Point::from((0.8, 0.9)), at(16));
+        assert_eq!(state.position, before.position);
+        assert_eq!(state.velocity, before.velocity);
+        assert_eq!(state.anchor(at(16)), before.anchor(at(16)));
+        assert_eq!(state.anchor(at(96)), Point::from((0.8, 0.9)));
+        assert!(!state.released());
+    }
+
+    #[test]
+    fn saturation_and_release_taper_do_not_jump() {
+        let mut state = make();
+        state.config.damping = 10;
+        state.config.frequency = 2;
+        state.push(Point::from((300., 0.)), Duration::ZERO);
+        state.advance(at(50));
+        let position = state.position;
+        state.push(Point::from((1e308, 0.)), at(50));
+        assert_eq!(state.position, position);
+        state.release(at(50));
+        state.advance(at(1800));
+        let shown = state.deformation();
+        let (e, de) = state.envelope();
+        let velocity = state.velocity.upscale(e) + state.position.upscale(de);
+        state.grab(Point::from((0.5, 0.5)), at(1800));
+        assert_eq!(state.deformation(), shown);
+        assert_eq!(state.velocity, velocity);
+    }
+
+    #[test]
+    fn slow_release_envelope_is_frame_independent_and_ends_at_rest() {
+        let mut one = make();
+        one.config.damping = 10;
+        one.config.frequency = 2;
+        one.push(Point::from((300., 0.)), Duration::ZERO);
+        one.release(Duration::ZERO);
+        let mut many = one.clone();
+        one.advance(at(1999));
+        for ms in 1..=1999 {
+            many.advance(at(ms));
+        }
+        near(one.deformation().x, many.deformation().x);
+        assert!(one.deformation().x.abs() < 0.00001);
+        let (e, de) = one.envelope();
+        assert!((one.velocity.x * e + one.position.x * de).abs() < 0.001);
+        one.advance(at(2000));
+        assert_eq!(one.deformation(), Point::from((0., 0.)));
+        assert!(!one.is_moving());
+    }
+
+    #[test]
+    fn critical_damping_and_minimum_damping_finish_without_nan() {
+        for damping in [10, 65, 100] {
+            let mut state = make();
+            state.config.damping = damping;
+            state.config.frequency = 2;
+            state.push(Point::from((120., 30.)), Duration::ZERO);
+            state.release(at(16));
+            for ms in 17..2016 {
+                state.advance(at(ms));
+                assert!(state.position.x.is_finite());
+            }
+            state.advance(at(2016));
+            assert!(!state.is_moving());
+        }
+    }
+}
