+    Op::CompleteAnimations.apply(&mut layout);
+    Op::SwapWindowInDirection(ScrollDirection::Right).apply(&mut layout);
+    assert_eq!(swap_sources(&layout), vec!["next", "next"]);
+}
+
+#[test]
+fn swap_routing_without_override_retains_ordinary_movement() {
+    let mut options = swap_test_options();
+    options.animations.window_swap = None;
+    let mut layout = resize_handoff_layout_with_options(false, options);
+    Op::SwapWindowInDirection(ScrollDirection::Right).apply(&mut layout);
+    assert!(swap_sources(&layout).is_empty());
+    assert!(layout.are_animations_ongoing(None));
+}
+
+#[test]
+fn swap_routing_off_overrides_an_active_material_on_repeat() {
+    let mut layout = resize_handoff_layout_with_options(false, swap_test_options());
+    Op::SwapWindowInDirection(ScrollDirection::Right).apply(&mut layout);
+    let mut changed = swap_test_options();
+    let config = changed.animations.window_swap.as_mut().unwrap();
+    config.anim.off = true;
+    config.custom_shader = None;
+    layout.update_options(changed);
+    Op::SwapWindowInDirection(ScrollDirection::Left).apply(&mut layout);
+    let columns = layout.active_workspace().unwrap().scrolling();
+    assert!(columns
+        .columns()
+        .all(|column| column.swap_animation().unwrap().anim.off));
+    assert!(swap_sources(&layout).is_empty());
+}
