+/// An explicit swap owns its timed material; absence follows ordinary movement.
+#[derive(Debug, Clone, PartialEq)]
+pub struct WindowSwapAnim {
+    pub anim: Animation,
+    pub custom_shader: Option<String>,
+}
+
+impl<S> knuffel::Decode<S> for WindowSwapAnim
+where
+    S: knuffel::traits::ErrorSpan,
+{
+    fn decode_node(
+        node: &knuffel::ast::SpannedNode<S>,
+        ctx: &mut knuffel::decode::Context<S>,
+    ) -> Result<Self, DecodeError<S>> {
+        let mut custom_shader = None;
+        let anim = Animation::decode_node(
+            node,
+            ctx,
+            WindowMovementAnim::default().anim,
+            |child, ctx| {
+                if &**child.node_name == "custom-shader" {
+                    custom_shader = parse_arg_node("custom-shader", child, ctx)?;
+                    Ok(true)
+                } else {
+                    Ok(false)
+                }
+            },
+        )?;
+        Ok(Self {
+            anim,
+            custom_shader,
+        })
+    }
+}
