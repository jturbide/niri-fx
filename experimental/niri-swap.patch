+fn swap_test_options() -> Options {
+    let mut options = make_options();
+    options.animations.window_movement.custom_shader = Some("move".into());
+    options.animations.window_swap = Some(niri_config::animations::WindowSwapAnim {
+        anim: options.animations.window_movement.anim,
+        custom_shader: Some("swap".into()),
+    });
+    options
+}
+
+fn swap_sources(layout: &Layout<TestWindow>) -> Vec<String> {
+    let scrolling = layout.active_workspace().unwrap().scrolling();
+    scrolling
+        .columns()
+        .filter_map(|col| col.swap_animation())
+        .chain(scrolling.tiles().filter_map(|tile| tile.swap_animation()))
+        .filter_map(|config| config.custom_shader.clone())
+        .collect()
+}
+
+#[test]
+fn swap_routing_tags_both_singleton_columns_and_keeps_ordinary_moves_separate() {
+    let mut layout = resize_handoff_layout_with_options(false, swap_test_options());
+    assert!(swap_sources(&layout).is_empty());
+    Op::SwapWindowInDirection(ScrollDirection::Right).apply(&mut layout);
+    assert_eq!(swap_sources(&layout), vec!["swap", "swap"]);
+    Op::CompleteAnimations.apply(&mut layout);
+    Op::MoveColumnLeft.apply(&mut layout);
+    assert!(swap_sources(&layout).is_empty());
+}
+
+#[test]
+fn swap_routing_tags_only_the_two_swapped_tiles_in_stacked_columns() {
+    let mut layout = check_ops_with_options(
+        swap_test_options(),
+        [
+            Op::AddOutput(1),
+            Op::AddWindow {
+                params: TestWindowParams::new(1),
+            },
+            Op::AddWindow {
+                params: TestWindowParams::new(2),
+            },
+            Op::FocusColumnLeft,
+            Op::ConsumeWindowIntoColumn,
+            Op::AddWindow {
+                params: TestWindowParams::new(3),
+            },
+            Op::CompleteAnimations,
+            Op::SwapWindowInDirection(ScrollDirection::Left),
+        ],
+    );
+    assert_eq!(swap_sources(&layout), vec!["swap", "swap"]);
+    layout.verify_invariants();
+    let mut changed = swap_test_options();
+    changed
+        .animations
+        .window_swap
+        .as_mut()
+        .unwrap()
+        .custom_shader = Some("next".into());
+    layout.update_options(changed);
+    Op::SwapWindowInDirection(ScrollDirection::Right).apply(&mut layout);
+    assert_eq!(swap_sources(&layout), vec!["swap", "swap"]);
+    Op::CompleteAnimations.apply(&mut layout);
+    assert!(swap_sources(&layout).is_empty());
+}
