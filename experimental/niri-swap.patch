+
+/// Swap snapshots carry their source across reloads; each renderer owns its cache.
+pub fn swap_program(renderer: &mut GlesRenderer, source: &str) -> Result<ShaderProgram, GlesError> {
+    let old = Shaders::get(renderer).swap_programs.take();
+    let mut live = std::collections::HashMap::new();
+    for (key, program) in old {
+        if key == source || !program.is_unique() {
+            live.insert(key, program);
+        } else if let Err(err) = program.destroy(renderer) {
+            warn!("error destroying retired swap shader: {err:?}");
+        }
+    }
+    let cached = live.get(source).cloned();
+    Shaders::get(renderer).swap_programs.replace(live);
+    if let Some(program) = cached {
+        return Ok(program);
+    }
+    let program = match compile_move_program(renderer, source) {
+        Ok(program) => program,
+        Err(error) => {
+            Shaders::get(renderer)
+                .failed_swap_sources
+                .borrow_mut()
+                .insert(source.into());
+            return Err(error);
+        }
+    };
+    Shaders::get(renderer)
+        .failed_swap_sources
+        .borrow_mut()
+        .remove(source);
+    Shaders::get(renderer)
+        .swap_programs
+        .borrow_mut()
+        .insert(source.into(), program.clone());
+    Ok(program)
+}
+
+/// Compile configured swaps at the same startup/reload boundary as movement.
+pub fn prepare_swap_program(renderer: &mut GlesRenderer, source: Option<&str>) {
+    // Failed sources only suppress retries in this configuration generation.
+    Shaders::get(renderer)
+        .failed_swap_sources
+        .borrow_mut()
+        .clear();
+    if let Some(source) = source {
+        if let Err(error) = swap_program(renderer, source) {
+            warn!("error compiling custom swap shader: {error:?}");
+        }
+    }
+}
